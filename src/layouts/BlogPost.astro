---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Divider from '../components/Divider.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 740px;
				margin: auto;
				padding: 1.2em 1em 5em;
			}

			/* パンくず風ナビ */
			.breadcrumb {
				font-size: 0.8em;
				color: var(--text-muted);
				margin-bottom: 0.8em;
				display: flex;
				align-items: center;
				gap: 0.4em;
				font-family: var(--font-hand);
			}
			.breadcrumb a { color: var(--green); }
			.breadcrumb::before { content: '›'; margin-right: 0.3em; color: var(--green-light); }

			/* ヒーロー画像：クレヨンの額縁のイメージ（コンパクトに、幅いっぱいでトリミング表示） */
			.hero-image {
				margin-bottom: 1.1em;
				max-height: 260px;
				border-radius: 22px 18px 24px 16px / 18px 24px 16px 22px;
				overflow: hidden;
				box-shadow: var(--shadow-md);
				border: 3px solid var(--beige);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 260px;
				object-fit: cover;
				border-radius: 0;
				filter: url(#crayon-photo);
			}

			/* 記事ヘッダー */
			.article-header {
				background: #fff;
				border-radius: 20px 16px 22px 14px / 16px 22px 14px 20px;
				border: 2px solid var(--border);
				box-shadow: var(--shadow-sm);
				overflow: hidden;
				margin-bottom: 1.1em;
			}
			.article-header__bar {
				height: 8px;
				background: var(--green-light);
			}
			.article-header__body {
				padding: 1.2em 1.6em;
			}
			.article-header__meta {
				display: flex;
				align-items: center;
				gap: 0.5em;
				font-size: 0.8em;
				color: var(--green-light);
				font-weight: 600;
				margin-bottom: 0.5em;
				font-family: var(--font-hand);
			}
			.article-header__meta::before { content: none; }
			.article-header h1 {
				font-size: 1.45em;
				line-height: 1.35;
				margin: 0 0 0.5em;
				color: var(--text);
			}
			.article-header__desc {
				font-size: 0.92em;
				color: var(--text-muted);
				line-height: 1.7;
				margin: 0;
				padding: 0.9em 1em;
				background: var(--cream);
				border-radius: 4px 14px 4px 14px;
				border-left: 3px solid var(--green-light);
			}

			/* 本文：紙に手描きしたイメージ */
			.prose {
				background: #fff;
				border-radius: 22px 18px 24px 16px / 18px 24px 16px 22px;
				border: 2px solid var(--border);
				box-shadow: var(--shadow-sm);
				padding: 2em 2.2em;
				font-size: 1em;
				color: var(--text);
			}

			/* フッター装飾 */
			.article-footer {
				margin-top: 1.2em;
				text-align: center;
				color: var(--text-muted);
				font-size: 0.85em;
				font-family: var(--font-hand);
				padding: 1.4em;
				background: var(--green-pale);
				border-radius: 18px 14px 20px 12px / 14px 20px 12px 18px;
				border: 2px dashed var(--green-light);
			}
			.article-footer::before { content: none; }

			@media (max-width: 720px) {
				main { padding: 1em 0.8em 3em; }
				.article-header__body { padding: 1.3em 1.2em; }
				.article-header h1 { font-size: 1.3em; }
				.prose { padding: 1.4em 1.2em; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<nav class="breadcrumb">
				<a href="/blog">記事一覧</a>
				<span>›</span>
				<span>{title}</span>
			</nav>

			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}

				<div class="article-header">
					<div class="article-header__bar" />
					<div class="article-header__body">
						<div class="article-header__meta">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span>（更新: <FormattedDate date={updatedDate} />）</span>
							)}
						</div>
						<h1>{title}</h1>
						{description && (
							<p class="article-header__desc">{description}</p>
						)}
					</div>
				</div>

				<div class="prose">
					<slot />
				</div>

				<Divider variant="grass" />

				<div class="article-footer">
					最後まで読んでくれてありがとう！また遊びにきてね。
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
