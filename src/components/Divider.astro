---
// 直線ではなく、草・葉っぱ・雲・しっぽカーブの手描き区切り線
interface Props {
	variant?: 'grass' | 'leaf' | 'cloud' | 'curl';
	class?: string;
}
const { variant = 'grass', class: klass = '' } = Astro.props;
---

<div class={`hand-divider ${klass}`} aria-hidden="true">
	{variant === 'grass' && (
		<svg viewBox="0 0 800 34" preserveAspectRatio="none" style="filter:url(#hand-wobble)">
			<path d="M0 20 Q40 10 80 20 T160 20 T240 20 T320 20 T400 20 T480 20 T560 20 T640 20 T720 20 T800 20"
				fill="none" stroke="var(--green-light)" stroke-width="2" stroke-linecap="round" />
			{Array.from({ length: 20 }).map((_, i) => (
				<path
					d={`M${20 + i * 40} 20 q-3 -12 -8 -16 M${20 + i * 40} 20 q6 -10 3 -18`}
					fill="none" stroke="var(--green)" stroke-width="1.6" stroke-linecap="round"
				/>
			))}
		</svg>
	)}

	{variant === 'leaf' && (
		<svg viewBox="0 0 800 30" preserveAspectRatio="none" style="filter:url(#hand-wobble)">
			<path d="M0 15 H800" fill="none" stroke="var(--beige)" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 14" />
			{Array.from({ length: 12 }).map((_, i) => (
				<ellipse cx={30 + i * 66} cy="15" rx="9" ry="5.5"
					transform={`rotate(${i % 2 === 0 ? 25 : -25} ${30 + i * 66} 15)`}
					fill="var(--green-light)" stroke="var(--green-dark)" stroke-width="1.2" />
			))}
		</svg>
	)}

	{variant === 'cloud' && (
		<svg viewBox="0 0 800 40" preserveAspectRatio="none" style="filter:url(#hand-wobble)">
			{Array.from({ length: 6 }).map((_, i) => (
				<g transform={`translate(${40 + i * 130} 18)`}>
					<circle cx="0" cy="0" r="8" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.5" />
					<circle cx="10" cy="-3" r="6" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.5" />
					<circle cx="-10" cy="-2" r="5.5" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.5" />
				</g>
			))}
		</svg>
	)}

	{variant === 'curl' && (
		<svg viewBox="0 0 800 40" preserveAspectRatio="none" style="filter:url(#hand-wobble)">
			<path
				d="M0 20 C 40 0, 80 40, 120 20 S 200 0, 240 20 S 320 40, 360 20 S 440 0, 480 20 S 560 40, 600 20 S 680 0, 720 20 S 780 30, 800 20"
				fill="none" stroke="var(--orange-light)" stroke-width="2.4" stroke-linecap="round"
			/>
		</svg>
	)}
</div>

<style>
	.hand-divider {
		width: 100%;
		margin: 2.2em 0;
		line-height: 0;
	}
	.hand-divider svg {
		width: 100%;
		height: 30px;
		display: block;
	}
</style>
