---
// 限定の扉のページ（/zukan/park-gentei/ など）。写真がずらっと並ぶことを優先し、
// カードは「写真・商品名・値段・お店」だけ。カード全体を押すと記事へ飛ぶ（行き止まりなし）
import BaseHead from './BaseHead.astro';
import CrayonDoor from './CrayonDoor.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { SITE_TITLE } from '../consts';
import { getGenteiCards, getGenteiDoor, getGenteiDoors } from '../zukan-gentei';

interface Props {
	place: string;
}
const { place } = Astro.props;
const door = getGenteiDoor(place);
const cards = getGenteiCards(place);

// エリアごとにまとめる。決まったエリア → その他 の順。各エリアの中は写真のあるものが先（撮影待ちは最後）
const OTHER = 'その他';
const areaOf = (area: string) => (door.areas.includes(area) ? area : OTHER);
const groups = [...door.areas, OTHER]
	.map((area) => ({
		area,
		cards: cards
			.filter((c) => areaOf(c.area) === area)
			.sort((a, b) => Number(!a.image) - Number(!b.image)),
	}))
	.filter((g) => g.cards.length > 0);

const otherDoors = getGenteiDoors().filter((d) => d.place !== place);
const description = `${door.name}グッズ${cards.length}点を写真で一覧に。買えるお店と価格つき。${door.asOf}`;
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`${door.emoji} ${door.name}グッズ一覧 | 図鑑 | ${SITE_TITLE}`} description={description} />
	<style>
		.g-header {
			text-align: center;
			padding: 1.2em 1em 0.6em;
			background: #fff;
		}
		.g-header__label {
			font-size: 0.7em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			display: block;
			margin-bottom: 0.5em;
		}
		.g-header__title {
			font-family: 'Yomogi', 'Kaisei Decol', 'Hiragino Maru Gothic ProN', serif;
			font-size: 1.8em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.4em;
			line-height: 1.3;
		}
		.g-header__lead {
			max-width: 640px;
			margin: 0 auto 0.3em;
			font-size: 0.88em;
			line-height: 1.8;
			color: var(--text);
		}
		.g-header__asof {
			margin: 0;
			font-size: 0.74em;
			color: var(--text-muted);
		}
		.g-links {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 8px;
			margin-top: 0.9em;
		}
		.g-links a {
			font-size: 0.78em;
			font-weight: 700;
			color: var(--green-dark);
			background: var(--green-pale);
			border: 1px solid var(--green-light);
			border-radius: 20px;
			padding: 0.35em 1em;
			text-decoration: none;
		}
		.g-links a:hover { opacity: 0.8; text-decoration: none; }

		/* ── エリアの絞り込み ── */
		.g-filter {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 6px;
			padding: 1em 1em 0;
		}
		.g-filter button {
			font-family: inherit;
			font-size: 0.8em;
			font-weight: 700;
			color: var(--text-muted);
			background: #fff;
			border: 1.5px solid var(--beige);
			border-radius: 20px;
			padding: 0.35em 1em;
			cursor: pointer;
		}
		.g-filter button[aria-pressed='true'] {
			color: #fff;
			background: var(--orange);
			border-color: var(--orange);
		}

		.g-outer {
			max-width: 1180px;
			margin: 0 auto;
			padding: 0 1em 4em;
		}
		.g-area__title {
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', serif;
			font-size: 1.15em;
			font-weight: 700;
			color: var(--text);
			margin: 1.6em 0 0.6em;
			padding-bottom: 0.3em;
			border-bottom: 2px dashed var(--beige);
		}
		.g-area__count {
			font-size: 0.7em;
			color: var(--text-muted);
			margin-left: 0.4em;
		}

		/* ── カード（写真が主役） ── */
		.g-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 12px;
		}
		.g-card {
			position: relative;
			display: block;
			background: #fff;
			border-radius: 12px;
			overflow: hidden;
			border: 2px solid var(--beige-light);
			box-shadow: var(--shadow-sm);
			color: inherit;
			text-decoration: none;
			transition: box-shadow 0.2s, transform 0.2s;
		}
		.g-card:hover {
			box-shadow: var(--shadow-hover);
			transform: translateY(-2px);
			text-decoration: none;
		}
		.g-card__img {
			aspect-ratio: 1 / 1;
			background: var(--milk-dark);
			overflow: hidden;
		}
		.g-card__img img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.25s;
		}
		.g-card:hover .g-card__img img { transform: scale(1.04); }
		.g-card__wait {
			height: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.2em;
			color: var(--text-muted);
			font-size: 0.75em;
			font-weight: 700;
		}
		.g-card__wait span { font-size: 2em; opacity: 0.6; }
		.g-card__badge {
			position: absolute;
			top: 6px;
			left: 6px;
			font-size: 0.62em;
			font-weight: 700;
			color: #fff;
			background: var(--orange);
			border-radius: 10px;
			padding: 0.15em 0.6em;
		}
		.g-card__info { padding: 6px 8px 8px; }
		.g-card__name {
			font-size: 0.74em;
			font-weight: 700;
			line-height: 1.4;
			min-height: 2.8em;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.g-card__meta {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 0.5em;
			margin-top: 2px;
			font-size: 0.68em;
		}
		.g-card__price { font-weight: 700; color: var(--orange-dark); }
		.g-card__shop { color: var(--green-dark); }

		.g-more {
			text-align: center;
			margin-top: 3em;
		}
		.g-more__title {
			font-size: 0.72em;
			font-weight: 700;
			color: var(--text-muted);
			letter-spacing: 0.12em;
			margin: 0 0 0.8em;
		}
		.g-more__doors {
			display: flex;
			justify-content: center;
			gap: 1.2em;
		}
		.g-more__doors a {
			width: 90px;
			text-decoration: none;
			color: var(--orange-dark);
			font-size: 0.74em;
			font-weight: 700;
		}

		@media (max-width: 560px) {
			.g-header__title { font-size: 1.5em; }
			.g-outer { padding: 0 0.6em 3em; }
			/* スマホは3列で写真をぎゅっと並べる */
			.g-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
			.g-card { border-width: 1.5px; border-radius: 9px; }
			.g-card__info { padding: 4px 5px 6px; }
			.g-card__name { font-size: 0.66em; }
			.g-card__meta { font-size: 0.62em; }
			.g-card__badge { top: 4px; left: 4px; font-size: 0.56em; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="g-header">
			<span class="g-header__label">ZUKAN ・ 限定の扉</span>
			<h1 class="g-header__title">{door.emoji} {door.name}</h1>
			<p class="g-header__lead">{door.lead}</p>
			<p class="g-header__asof">{cards.length}点 ・ {door.asOf}</p>
			<div class="g-links">
				{door.links.map((l) => <a href={l.href}>{l.label}</a>)}
			</div>
		</div>

		{groups.length > 1 && (
			<div class="g-filter" role="group" aria-label="エリアで絞り込む">
				<button type="button" data-area="" aria-pressed="true">すべて</button>
				{groups.map((g) => (
					<button type="button" data-area={g.area} aria-pressed="false">
						{g.area}（{g.cards.length}）
					</button>
				))}
			</div>
		)}

		<div class="g-outer">
			{groups.map((g) => (
				<section class="g-area" data-area={g.area}>
					<h2 class="g-area__title">
						{g.area}<span class="g-area__count">{g.cards.length}点</span>
					</h2>
					<div class="g-grid">
						{g.cards.map((c) => (
							<a class="g-card" href={c.link}>
								<div class="g-card__img">
									{c.image ? (
										<img src={c.image} alt={c.name} loading="lazy" />
									) : (
										<div class="g-card__wait"><span>📷</span>撮影待ち</div>
									)}
								</div>
								{c.linkType === 'review' && <span class="g-card__badge">レビュー</span>}
								<div class="g-card__info">
									<div class="g-card__name">{c.name}</div>
									<div class="g-card__meta">
										{c.price != null && <span class="g-card__price">¥{c.price.toLocaleString()}</span>}
										{c.shop && <span class="g-card__shop">📍{c.shop}</span>}
									</div>
								</div>
							</a>
						))}
					</div>
				</section>
			))}

			<div class="g-more">
				<p class="g-more__title">— ほかの扉 —</p>
				<div class="g-more__doors">
					{otherDoors.map((d) => (
						<a href={`/zukan/${d.slug}/`}>
							<CrayonDoor slug={`more-${d.slug}`} label={d.short} base={d.base} dark={d.dark} />
						</a>
					))}
					<a href="/zukan/">
						<CrayonDoor slug="more-zukan" label="図書室" base="#F5C845" dark="#D19E1D" />
					</a>
				</div>
			</div>
		</div>
	</main>
	<Footer />

	<!-- エリアの絞り込み（ページ内のセクションをその場で出し分ける） -->
	<script is:inline>
		(function () {
			var buttons = Array.prototype.slice.call(document.querySelectorAll('.g-filter button'));
			var sections = Array.prototype.slice.call(document.querySelectorAll('.g-area'));
			buttons.forEach(function (b) {
				b.addEventListener('click', function () {
					var area = b.getAttribute('data-area');
					buttons.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
					sections.forEach(function (s) {
						s.style.display = !area || s.getAttribute('data-area') === area ? '' : 'none';
					});
				});
			});
		})();
	</script>
</body>
</html>
