---
import HandIcon from './HandIcon.astro';
const today = new Date();
---

<footer class="site-footer">
	<div class="site-footer__garden" aria-hidden="true">
		<svg viewBox="0 0 800 90" preserveAspectRatio="none" style="filter:url(#hand-wobble)">
			<!-- 雲 -->
			<g opacity="0.9">
				<circle cx="90" cy="18" r="9" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.4" />
				<circle cx="104" cy="14" r="7" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.4" />
				<circle cx="640" cy="14" r="8" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.4" />
				<circle cx="656" cy="18" r="6" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="1.4" />
			</g>
			<!-- 小道 -->
			<path d="M0 78 Q200 68 400 78 T800 78" fill="none" stroke="var(--wood-light)" stroke-width="10" stroke-linecap="round" opacity="0.55" />
			<!-- 草の地面 -->
			<path d="M0 82 Q400 72 800 82 V90 H0 Z" fill="var(--green-pale)" />
			<!-- 草の生えぎわ -->
			<path d="M0 82 Q400 72 800 82" fill="none" stroke="var(--green-light)" stroke-width="2" />
			{Array.from({ length: 26 }).map((_, i) => (
				<path
					d={`M${10 + i * 31} 82 q-3 -10 -7 -13 M${10 + i * 31} 82 q5 -9 2 -15`}
					fill="none" stroke="var(--green)" stroke-width="1.5" stroke-linecap="round"
				/>
			))}
			<!-- お花（色とりどり） -->
			{[
				[70, '#E3A0B4'],
				[230, 'var(--mustard)'],
				[400, '#B7A8D6'],
				[560, '#E3A0B4'],
				[720, 'var(--orange-light)'],
			].map(([x, c]) => (
				<g transform={`translate(${x} 74)`}>
					<circle cx="0" cy="-6" r="3" fill={c} />
					<circle cx="4" cy="-3" r="3" fill={c} />
					<circle cx="-4" cy="-3" r="3" fill={c} />
					<circle cx="0" cy="0" r="3" fill={c} />
					<circle cx="0" cy="-3" r="2" fill="var(--mustard-light)" />
				</g>
			))}
			<!-- 木（左右） -->
			<g transform="translate(40 40)">
				<path d="M0 40V15" stroke="var(--wood-dark)" stroke-width="4" stroke-linecap="round" />
				<circle cx="0" cy="4" r="16" fill="var(--green-light)" stroke="var(--green-dark)" stroke-width="1.6" />
			</g>
			<g transform="translate(750 42)">
				<path d="M0 38V13" stroke="var(--wood-dark)" stroke-width="4" stroke-linecap="round" />
				<circle cx="0" cy="2" r="14" fill="var(--green-light)" stroke="var(--green-dark)" stroke-width="1.6" />
			</g>
		</svg>
	</div>

	<div class="site-footer__body">
		<p class="site-footer__copy">
			&copy; {today.getFullYear()} エンジョイ！ジブリライフ！ All rights reserved.
		</p>
		<div class="site-footer__links">
			<a href="/about"><HandIcon name="profile" size={14} />プロフィール</a>
			<span class="sep">・</span>
			<a href="/privacy">プライバシーポリシー・免責事項</a>
			<span class="sep">・</span>
			<a href="/contact"><HandIcon name="mail" size={14} />お問い合わせ</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 3em;
		background: var(--green-pale);
	}
	.site-footer__garden {
		line-height: 0;
	}
	.site-footer__garden svg {
		width: 100%;
		height: 90px;
		display: block;
	}
	.site-footer__body {
		text-align: center;
		padding: 1.6em 1em 3.5em;
		color: var(--text-muted);
	}
	.site-footer__copy {
		font-size: 0.85em;
		margin: 0 0 0.6em;
	}
	.site-footer__links {
		font-size: 0.82em;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6em;
		flex-wrap: wrap;
	}
	.site-footer__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		color: var(--text-muted);
		text-decoration: none;
	}
	.site-footer__links a:hover {
		color: var(--orange-dark);
		text-decoration: underline;
	}
	.sep { opacity: 0.6; }
</style>
