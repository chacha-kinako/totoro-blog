---
// サイト全体で使う手描きフィルターの定義（1回だけDOMに置けばOK）
// Header.astro から読み込まれ、全ページで共通利用される
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
	<defs>
		<!-- 線・図形を少し揺らす（ドア・ボタン・カード枠・アイコン共通） -->
		<filter id="hand-wobble" x="-15%" y="-15%" width="130%" height="130%">
			<feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="4" result="n1" />
			<feDisplacementMap in="SourceGraphic" in2="n1" scale="2.6" />
		</filter>

		<!-- アイコン用（もう少し細かい揺れ） -->
		<filter id="hand-wobble-sm" x="-20%" y="-20%" width="140%" height="140%">
			<feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="9" result="n2" />
			<feDisplacementMap in="SourceGraphic" in2="n2" scale="1.4" />
		</filter>

		<!-- 写真にクレヨン・オイルパステル質感を重ねる（控えめ・写真の情報は保持） -->
		<filter id="crayon-photo" x="-1.5%" y="-1.5%" width="103%" height="103%" color-interpolation-filters="sRGB">
			<!-- 輪郭をほんの少しだけにじませる -->
			<feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="6" result="wob" />
			<feDisplacementMap in="SourceGraphic" in2="wob" scale="2.6" result="wobbled" />

			<!-- 彩度を少し落として、色鉛筆っぽい発色に -->
			<feColorMatrix in="wobbled" type="saturate" values="0.86" result="tinted" />

			<!-- ごく薄い紙のざらつき（クレヨンで塗った質感） -->
			<feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="3" result="grain" />
			<feColorMatrix in="grain" type="matrix"
				values="0 0 0 0 0.32  0 0 0 0 0.24  0 0 0 0 0.16  0.1 0.1 0.1 0 -0.08" result="grainSpeckle" />
			<feComposite in="grainSpeckle" in2="tinted" operator="over" />
		</filter>
	</defs>
</svg>
