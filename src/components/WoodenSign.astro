---
// サイドバー用：木製看板コンポーネント（クレヨンで描いた明るい木の板）
// 看板ごとに木の色味を少しずつ変える
import HandIcon from './HandIcon.astro';

interface Props {
	title: string;
	icon: 'article' | 'heart' | 'work' | 'category' | 'book' | 'profile';
	color?: 'wood' | 'green' | 'blue' | 'mustard' | 'orange';
	moreHref?: string;
	moreLabel?: string;
	open?: boolean;
}
const {
	title,
	icon,
	color = 'wood',
	moreHref,
	moreLabel = 'もっと見る',
	open = false,
} = Astro.props;
---

<div class={`wsign wsign--${color}`} data-open={String(open)}>
	<button class="wsign__head" type="button" aria-expanded={String(open)}>
		<span class="wsign__nail wsign__nail--l"></span>
		<span class="wsign__nail wsign__nail--r"></span>
		<HandIcon name={icon} size={17} class="wsign__icon" />
		<span class="wsign__title">{title}</span>
		<span class="wsign__arrow"><HandIcon name="arrow" size={13} /></span>
	</button>
	<div class="wsign__body">
		<div class="wsign__inner">
			<slot />
			{moreHref && (
				<a href={moreHref} class="wsign__more">
					{moreLabel} <span class="wsign__paw" aria-hidden="true">🐾</span>
				</a>
			)}
		</div>
	</div>
</div>

<script>
	document.querySelectorAll('.wsign__head').forEach((btn) => {
		btn.addEventListener('click', () => {
			const sign = btn.closest('.wsign');
			if (!sign) return;
			const isOpen = sign.getAttribute('data-open') === 'true';
			sign.setAttribute('data-open', String(!isOpen));
			btn.setAttribute('aria-expanded', String(!isOpen));
		});
	});
</script>

<style>
	.wsign {
		--plank: #DBB88C;
		--plank-dark: #8A5F3E;
		--plank-pale: #FFFDF6;
		margin-bottom: 1em;
		border-radius: 14px 18px 12px 20px / 18px 12px 20px 14px;
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		border: 2.5px solid var(--plank);
		background: var(--plank-pale);
	}
	.wsign--wood    { --plank: #DBB88C; --plank-dark: #8A5F3E; }
	.wsign--green   { --plank: #C9CD97; --plank-dark: #6B7A44; }
	.wsign--blue    { --plank: #B9C8CC; --plank-dark: #5F7C8C; }
	.wsign--mustard { --plank: #E5C784; --plank-dark: #A6791F; }
	.wsign--orange  { --plank: #E0B195; --plank-dark: #94523A; }

	.wsign__head {
		position: relative;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.7em 0.9em 0.7em 1.6em;
		background-color: var(--plank);
		/* 木目（クレヨンでこすったような横線） */
		background-image: repeating-linear-gradient(
			180deg,
			rgba(120, 80, 40, 0.09) 0 2px,
			transparent 2px 9px
		);
		color: var(--plank-dark);
		border: none;
		border-bottom: 2px solid var(--plank);
		cursor: pointer;
		font-family: var(--font-hand);
	}
	.wsign__nail {
		position: absolute;
		top: 50%;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(100, 65, 35, 0.45);
		box-shadow: 0 1px 1px rgba(255, 255, 255, 0.4);
		transform: translateY(-50%);
	}
	.wsign__nail--l { left: 8px; }
	.wsign__nail--r { right: 8px; }

	.wsign__icon { color: var(--plank-dark); flex-shrink: 0; }
	.wsign__title {
		flex: 1;
		text-align: left;
		font-size: 0.88em;
		font-weight: 700;
		letter-spacing: 0.03em;
	}
	.wsign__arrow {
		color: var(--plank-dark);
		opacity: 0.7;
		transition: transform 0.22s;
		display: flex;
	}
	.wsign[data-open="true"] .wsign__arrow { transform: rotate(90deg); }

	.wsign__body {
		max-height: 0;
		overflow: hidden;
		transition: max-height 0.28s ease;
		background: var(--plank-pale);
	}
	.wsign[data-open="true"] .wsign__body { max-height: 900px; }

	.wsign__inner { padding: 0.8em 0.9em 0.9em; }

	.wsign__more {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		margin-top: 0.6em;
		padding: 0.35em 1.1em;
		font-size: 0.76em;
		font-weight: 700;
		font-family: var(--font-hand);
		color: var(--plank-dark);
		background-color: var(--plank);
		background-image: repeating-linear-gradient(
			180deg,
			rgba(120, 80, 40, 0.08) 0 2px,
			transparent 2px 8px
		);
		border-radius: 18px 22px 16px 24px / 22px 16px 24px 18px;
		text-decoration: none;
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.wsign__more:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}
	.wsign__paw { font-size: 0.95em; }
</style>
