---
import { getCollection } from 'astro:content';
import WoodenSign from './WoodenSign.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latestPosts = allPosts.slice(0, 6);
const popularPosts = allPosts.filter(p => p.data.showInPopular || p.data.featured).slice(0, 6);

const ghibliWorks = [
	{ icon: '🌱', name: 'となりのトトロ' },
	{ icon: '🛁', name: '千と千尋の神隠し' },
	{ icon: '🐺', name: 'もののけ姫' },
	{ icon: '🧹', name: '魔女の宅急便' },
	{ icon: '🏰', name: '天空の城ラピュタ' },
	{ icon: '🌾', name: '風の谷のナウシカ' },
	{ icon: '🐟', name: '崖の上のポニョ' },
	{ icon: '🔥', name: 'ハウルの動く城' },
];
---

<aside class="sidebar">
	<WoodenSign title="プロフィール" icon="profile" color="orange" moreHref="/about" moreLabel="自己紹介を見る">
		<a href="/about" class="sb-profile">
			<span class="sb-profile__avatar">🏠</span>
			<span class="sb-profile__text">
				トトロと暮らす丸窓の家から、<br />グッズと日々のことをのんびり発信中。
			</span>
		</a>
	</WoodenSign>

	<WoodenSign title="最新記事" icon="article" color="wood" open moreHref="/blog/latest">
		<ul class="sb-list">
			{latestPosts.map(post => (
				<li><a href={`/blog/${post.id}/`} class="sb-link">{post.data.title}</a></li>
			))}
		</ul>
	</WoodenSign>

	<WoodenSign title="人気記事" icon="heart" color="mustard" open moreHref={popularPosts.length > 0 ? '/blog/popular' : undefined}>
		<ul class="sb-list">
			{popularPosts.length > 0 ? popularPosts.map((post, i) => (
				<li class="sb-ranked">
					<span class={`sb-num sb-num--${(i % 3) + 1}`}>{i + 1}</span>
					<a href={`/blog/${post.id}/`} class="sb-link">{post.data.title}</a>
				</li>
			)) : (
				<li class="sb-empty">準備中です🌿</li>
			)}
		</ul>
	</WoodenSign>

	<WoodenSign title="作品別" icon="work" color="blue" moreHref="/works">
		<ul class="sb-list">
			{ghibliWorks.map(w => (
				<li><a href={`/works/${encodeURIComponent(w.name)}`} class="sb-link">{w.icon} {w.name}</a></li>
			))}
		</ul>
	</WoodenSign>
</aside>

<style>
	.sidebar {
		width: 224px;
		flex-shrink: 0;
		position: sticky;
		top: 78px;
		max-height: calc(100vh - 90px);
		overflow-y: auto;
		scrollbar-width: thin;
		scrollbar-color: var(--beige) transparent;
		padding: 0.2em 0.2em 1em;
	}

	.sb-profile {
		display: flex;
		gap: 0.6em;
		align-items: flex-start;
		text-decoration: none;
		color: var(--text);
	}
	.sb-profile__avatar {
		font-size: 1.6em;
		flex-shrink: 0;
	}
	.sb-profile__text {
		font-size: 0.78em;
		line-height: 1.6;
	}

	.sb-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sb-list li { margin: 0; padding: 0; }

	.sb-link {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.78em;
		color: var(--text);
		text-decoration: none;
		padding: 0.35em 0.3em;
		border-radius: 6px;
		line-height: 1.5;
		transition: color 0.15s, background 0.15s;
	}
	.sb-link:hover {
		color: var(--orange-dark);
		background: rgba(255,255,255,0.6);
		text-decoration: none;
	}

	.sb-empty {
		display: block;
		font-size: 0.75em;
		color: var(--text-muted);
		padding: 0.3em 0.3em;
	}

	/* 人気記事の順位バッジ */
	.sb-ranked {
		display: flex;
		gap: 0.45em;
		align-items: flex-start;
	}
	.sb-num {
		flex-shrink: 0;
		width: 1.6em;
		height: 1.6em;
		margin-top: 0.35em;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.68em;
		font-weight: 700;
		font-family: var(--font-hand);
		border-radius: 50%;
		border: 2px solid;
		background: #fff;
	}
	.sb-num--1 { color: var(--mustard-dark); border-color: var(--mustard); }
	.sb-num--2 { color: var(--blue-ink); border-color: var(--blue-light); }
	.sb-num--3 { color: var(--pink-dark); border-color: var(--pink); }
	.sb-ranked .sb-link { flex: 1; }

	@media (max-width: 860px) {
		.sidebar { display: none; }
	}
</style>
