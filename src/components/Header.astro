---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const kakeiboHref = `/categories/${encodeURIComponent('お小遣い記録')}`;
---

<header class="site-header">
	<div class="site-header__inner">
		<a href="/" class="site-header__logo">{SITE_TITLE}</a>
		<nav class="site-header__nav">
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/zukan">図鑑</HeaderLink>
			<HeaderLink href="/blog">レビュー</HeaderLink>
			<HeaderLink href={kakeiboHref}>お小遣い</HeaderLink>
			<HeaderLink href="/about">プロフィール</HeaderLink>
			<HeaderLink href="/contact">お問い合わせ</HeaderLink>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: #fff;
		border-bottom: 1px solid var(--beige-light);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 1px 10px rgba(180, 100, 50, 0.07);
	}
	.site-header__inner {
		max-width: 1120px;
		margin: auto;
		padding: 0 1.5em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
		gap: 1em;
	}
	.site-header__logo {
		font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
		font-size: 0.95em;
		font-weight: 700;
		color: var(--orange-dark);
		text-decoration: none;
		letter-spacing: 0.05em;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.site-header__logo:hover { color: var(--orange); text-decoration: none; }

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 0.05em;
		flex-wrap: nowrap;
		overflow-x: auto;
	}
	.site-header__nav a {
		font-size: 0.8em;
		font-weight: 500;
		color: var(--text-muted);
		padding: 0.4em 0.65em;
		border-radius: 6px;
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
		white-space: nowrap;
	}
	.site-header__nav a:hover,
	.site-header__nav a.active {
		background: var(--orange-pale);
		color: var(--orange-dark);
		text-decoration: none;
	}

	@media (max-width: 680px) {
		.site-header__inner { padding: 0 0.8em; height: 52px; }
		.site-header__logo { font-size: 0.85em; }
		.site-header__nav a { padding: 0.3em 0.45em; font-size: 0.73em; }
	}
</style>
