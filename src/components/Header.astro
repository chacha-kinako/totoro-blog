---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import HandIcon from './HandIcon.astro';
import CrayonDefs from './CrayonDefs.astro';
---

<CrayonDefs />
<header class="site-header">
	<div class="site-header__inner">
		<a href="/" class="site-header__logo">
			<span class="site-header__logo-door" aria-hidden="true">
				<svg viewBox="0 0 40 46" style="filter:url(#hand-wobble-sm)">
					<path d="M4 20C4 8 10 3 20 3s16 5 16 17v20H4Z" fill="var(--orange-pale)" stroke="var(--orange-dark)" stroke-width="2" />
					<path d="M20 3v40" stroke="var(--orange-dark)" stroke-width="1.4" opacity="0.5" />
					<circle cx="16" cy="26" r="1.6" fill="var(--orange-dark)" />
				</svg>
			</span>
			<span class="site-header__logo-text">{SITE_TITLE}</span>
		</a>
		<nav class="site-header__nav">
			<HeaderLink href="/"><HandIcon name="home" size={16} />ホーム</HeaderLink>
			<HeaderLink href="/zukan/all"><HandIcon name="book" size={16} />図鑑</HeaderLink>
			<HeaderLink href="/blog"><HandIcon name="article" size={16} />レビュー</HeaderLink>
			<HeaderLink href="/categories/お小遣い帳"><HandIcon name="tag" size={16} />お小遣い</HeaderLink>
			<HeaderLink href="/about"><HandIcon name="profile" size={16} />プロフィール</HeaderLink>
			<HeaderLink href="/contact"><HandIcon name="mail" size={16} />お問い合わせ</HeaderLink>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--milk);
		position: sticky;
		top: 0;
		z-index: 100;
		box-shadow: 0 2px 10px rgba(120, 80, 40, 0.09);
		border-bottom: 3px solid var(--beige);
	}
	.site-header__inner {
		max-width: 1120px;
		margin: auto;
		padding: 0 1.5em;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
		gap: 1em;
	}
	.site-header__logo {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-family: var(--font-hand);
		font-size: 1em;
		font-weight: 700;
		color: var(--orange-dark);
		text-decoration: none;
		letter-spacing: 0.03em;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.site-header__logo:hover { color: var(--orange); text-decoration: none; }
	.site-header__logo-door { width: 26px; height: 30px; display: block; flex-shrink: 0; }
	.site-header__logo-door svg { width: 100%; height: 100%; }

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 0.1em;
		flex-wrap: nowrap;
		overflow-x: auto;
	}
	.site-header__nav :global(a) {
		display: inline-flex !important;
		align-items: center;
		gap: 0.35em;
		font-size: 0.8em;
		font-weight: 500;
		font-family: var(--font-hand);
		color: var(--text-muted);
		padding: 0.45em 0.75em;
		border-radius: 14px 18px 12px 20px / 18px 12px 20px 14px;
		text-decoration: none;
		transition: background 0.15s, color 0.15s;
		white-space: nowrap;
	}
	.site-header__nav :global(a:hover),
	.site-header__nav :global(a.active) {
		background: var(--orange-pale);
		color: var(--orange-dark);
		text-decoration: none;
	}

	@media (max-width: 680px) {
		.site-header__inner {
			flex-direction: column;
			height: auto;
			padding: 0.6em 0.8em 0.4em;
			gap: 0.2em;
			align-items: flex-start;
		}
		.site-header__logo { font-size: 0.9em; }
		.site-header__logo-door { width: 22px; height: 26px; }
		.site-header__nav {
			width: 100%;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			padding-bottom: 0.4em;
		}
		.site-header__nav::-webkit-scrollbar { display: none; }
		.site-header__nav :global(a) { padding: 0.3em 0.55em; font-size: 0.74em; }
	}
</style>
