---
// 手描き風アイコンセット（クレヨンで描いたような線、揺らぎフィルター適用）
interface Props {
	name:
		| 'home' | 'search' | 'category' | 'profile' | 'mail'
		| 'article' | 'book' | 'work' | 'arrow' | 'menu' | 'heart' | 'calendar' | 'tag';
	size?: number;
	class?: string;
}
const { name, size = 20, class: klass = '' } = Astro.props;
---

<svg
	class={`hand-icon ${klass}`}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	style="filter:url(#hand-wobble-sm)"
>
	{name === 'home' && (
		<path d="M3.5 11.5 12 4l8.5 7.5 M5.5 10v9h13v-9 M9.5 19v-6h5v6" />
	)}
	{name === 'search' && (
		<>
			<circle cx="10.5" cy="10.5" r="6.3" />
			<path d="M15.2 15.2 20.5 20.5" />
		</>
	)}
	{name === 'category' && (
		<path d="M3.5 6.5h6l1.6 2.2H20.5V18a1 1 0 0 1-1 1H4.2a1 1 0 0 1-1-1V6.7Z" />
	)}
	{name === 'profile' && (
		<>
			<circle cx="12" cy="8.3" r="3.6" />
			<path d="M4.8 20c0.8-4 3.4-6 7.2-6s6.4 2 7.2 6" />
		</>
	)}
	{name === 'mail' && (
		<>
			<rect x="3.3" y="5.5" width="17.4" height="13" rx="2" />
			<path d="M4 6.5 12 13l8-6.5" />
		</>
	)}
	{name === 'article' && (
		<>
			<path d="M6 3.5h9l3.5 3.5V20a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1Z" />
			<path d="M8.5 11h7M8.5 14.5h7M8.5 17.5h4.5" />
		</>
	)}
	{name === 'book' && (
		<>
			<path d="M12 6.2C10 4.8 7 4.3 4 4.6v13.6c3-0.3 6 0.2 8 1.6 2-1.4 5-1.9 8-1.6V4.6c-3-0.3-6 0.2-8 1.6Z" />
			<path d="M12 6.2v13.6" />
		</>
	)}
	{name === 'work' && (
		<>
			<circle cx="12" cy="12" r="8.4" />
			<path d="M12 7.2v5l3.4 2" />
		</>
	)}
	{name === 'arrow' && (
		<path d="M4.5 12h14.5 M13.5 6.5 20 12l-6.5 5.5" />
	)}
	{name === 'menu' && (
		<path d="M4 7h16 M4 12.3h16 M4 17.5h11" />
	)}
	{name === 'heart' && (
		<path d="M12 20s-7.2-4.4-9.4-9C1 7.6 2.7 4.6 5.8 4.2c2-0.3 3.7 0.7 6.2 3 2.5-2.3 4.2-3.3 6.2-3 3.1 0.4 4.8 3.4 3.2 6.8C19.2 15.6 12 20 12 20Z" />
	)}
	{name === 'calendar' && (
		<>
			<rect x="3.6" y="5.3" width="16.8" height="15" rx="2" />
			<path d="M3.6 9.8h16.8 M8 3.5v4 M16 3.5v4" />
		</>
	)}
	{name === 'tag' && (
		<>
			<path d="M12.5 3.5h6a1 1 0 0 1 1 1v6l-9.5 9.5a1.4 1.4 0 0 1-2 0L3.5 15.5a1.4 1.4 0 0 1 0-2Z" />
			<circle cx="15.2" cy="7.2" r="1.3" />
		</>
	)}
</svg>
