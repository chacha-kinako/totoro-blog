---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const rooms = [
	{
		slug: 'nuigurumi',
		name: 'ぬいぐるみの部屋',
		roomIcon: '🧸',
		href: '/zukan/nuigurumi',
		desc: 'ぬいぐるみのコレクションを眺める',
	},
	{
		slug: 'toki',
		name: '陶器の部屋',
		roomIcon: '🍵',
		href: '/zukan/toki',
		desc: '陶器のコレクションを眺める',
	},
	{
		slug: 'figure',
		name: 'フィギアの部屋',
		roomIcon: '🪆',
		href: '/zukan/figure',
		desc: 'フィギアのコレクションを眺める',
	},
	{
		slug: 'shokki',
		name: '食器の部屋',
		roomIcon: '🍽️',
		href: '/zukan/shokki',
		desc: '食器のコレクションを眺める',
	},
	{
		slug: 'all',
		name: '総合部屋',
		roomIcon: '📦',
		href: '/zukan/all',
		desc: 'ジャンル関係なく全グッズを一覧で',
	},
];
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`図鑑 | ${SITE_TITLE}`} description="トトロ・ジブリグッズの図鑑。コレクションを眺めて楽しむ場所です。" />
	<style>
		/* ── ページヘッダー ── */
		.zukan-header {
			text-align: center;
			padding: 3em 1em 2.2em;
			background: #fff;
		}
		.zukan-header__label {
			display: inline-block;
			font-size: 0.7em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			margin-bottom: 0.6em;
			padding: 0.3em 1.1em;
			border: 1px solid var(--orange-light);
			border-radius: 50px;
			background: var(--orange-pale);
		}
		.zukan-header__title {
			font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
			font-size: 2em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.4em;
			line-height: 1.3;
		}
		.zukan-header__desc {
			font-size: 0.88em;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.8;
		}

		/* ── 部屋グリッド ── */
		.room-section {
			padding: 3em 0 5em;
			background: var(--milk);
		}
		.room-section__inner {
			max-width: 900px;
			margin: 0 auto;
			padding: 0 1.5em;
		}
		.room-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 1.6rem;
		}

		/* ── 部屋カード ── */
		.room-card {
			background: #fff;
			border-radius: 20px;
			border: 1.5px solid var(--beige);
			box-shadow: var(--shadow-sm);
			overflow: hidden;
			transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
		}
		.room-card:hover {
			transform: translateY(-5px);
			box-shadow: var(--shadow-hover);
			border-color: var(--orange-light);
		}
		.room-card a {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 2.6em 1.5em 2.2em;
			text-decoration: none;
			color: inherit;
			gap: 0;
		}
		.room-card__door {
			font-size: 2.8em;
			line-height: 1;
			margin-bottom: 0.2em;
		}
		.room-card__item-icon {
			font-size: 2em;
			line-height: 1;
			margin-bottom: 0.55em;
		}
		.room-card__name {
			font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
			font-size: 1.15em;
			font-weight: 700;
			color: var(--text);
			margin-bottom: 0.45em;
			line-height: 1.3;
		}
		.room-card__desc {
			font-size: 0.78em;
			color: var(--text-muted);
			line-height: 1.55;
			margin-bottom: 1.3em;
		}
		.room-card__enter {
			display: inline-block;
			padding: 0.5em 1.6em;
			border-radius: 50px;
			border: 1.5px solid var(--orange-light);
			color: var(--orange-dark);
			font-size: 0.8em;
			font-weight: 700;
			transition: background 0.18s, color 0.18s;
		}
		.room-card:hover .room-card__enter {
			background: var(--orange);
			color: #fff;
			border-color: var(--orange);
		}
		.room-card__bar {
			height: 4px;
			width: 100%;
			background: linear-gradient(90deg, var(--orange) 0%, var(--orange-light) 50%, var(--green-light) 100%);
		}

		@media (max-width: 600px) {
			.room-grid { grid-template-columns: 1fr; gap: 1.1rem; }
			.zukan-header { padding: 2em 1em 1.6em; }
			.zukan-header__title { font-size: 1.6em; }
			.room-card a { padding: 2em 1.2em 1.8em; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="zukan-header">
			<span class="zukan-header__label">ZUKAN</span>
			<h1 class="zukan-header__title">📚 図鑑</h1>
			<p class="zukan-header__desc">
				コレクションを眺めて楽しむ場所です<br>
				部屋を選んでなかを覗いてみてください
			</p>
		</div>

		<section class="room-section">
			<div class="room-section__inner">
				<div class="room-grid">
					{rooms.map((room) => (
						<div class="room-card">
							<div class="room-card__bar" />
							<a href={room.href}>
								<span class="room-card__door">🚪</span>
								<span class="room-card__item-icon">{room.roomIcon}</span>
								<span class="room-card__name">{room.name}</span>
								<span class="room-card__desc">{room.desc}</span>
								<span class="room-card__enter">部屋に入る →</span>
							</a>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</body>
</html>
