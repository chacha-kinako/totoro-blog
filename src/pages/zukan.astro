---
import BaseHead from '../components/BaseHead.astro';
import CrayonDoor from '../components/CrayonDoor.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import siteConfig from '../data/site-config.json';
import { getZukanRooms } from '../zukan-rooms';

const interiorImage = siteConfig.hero?.interiorImage ?? '';
const toshoshitsuSignImage = siteConfig.hero?.toshoshitsuSignImage ?? '/images/toshoshitsu-sign.png';

// 部屋の扉は rooms.json（管理室が更新）から自動生成。最後に総合部屋が付く
const rooms = getZukanRooms();
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`図書室 | ${SITE_TITLE}`} description="トトロ・ジブリグッズの図鑑。コレクションを眺めて楽しむ場所です。" />
	<style>
		/* ── ページヘッダー（看板＋内観、他の3本柱と統一） ── */
		.zukan-header {
			padding: 1.2em 1.2em 0.6em;
		}
		.zukan-header__inner {
			max-width: 1100px;
			margin: 0 auto;
			display: flex;
			align-items: center;
			gap: 2em;
		}
		.zukan-header__sign {
			width: min(30%, 320px);
			flex-shrink: 0;
		}
		.zukan-header__sign img {
			width: 100%;
			height: auto;
			display: block;
		}
		.zukan-header__photo {
			flex: 1;
			min-width: 0;
		}
		.zukan-header__photo img {
			width: 100%;
			height: auto;
			max-height: 420px;
			display: block;
			border-radius: 22px 26px 20px 24px / 24px 20px 26px 22px;
			border: 3px solid var(--wood-light);
			box-shadow: var(--shadow-md);
			object-fit: cover;
		}
		.zukan-header__title-fallback {
			text-align: center;
			font-family: 'Yomogi', 'Kaisei Decol', 'Hiragino Maru Gothic ProN', serif;
			font-size: 1.5em;
			font-weight: 700;
			color: var(--text);
			margin: 0;
		}
		@media (max-width: 700px) {
			.zukan-header__inner {
				flex-direction: column;
				gap: 1em;
			}
			.zukan-header__sign {
				width: min(60%, 220px);
			}
			.zukan-header__photo img {
				max-height: 220px;
			}
		}

		/* ── 検索ボックス（ヘッダーの下・扉一覧の上） ── */
		.zukan-search-wrap {
			text-align: center;
			padding: 0.6em 1em 0;
		}
		.zukan-search {
			max-width: 480px;
			margin: 0 auto;
			display: flex;
			gap: 8px;
			padding: 0 1em;
		}
		.zukan-search input {
			flex: 1;
			min-width: 0;
			padding: 0.65em 1.1em;
			font-size: 16px;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			color: var(--text);
			background: #fffdf6;
			border: 2px solid var(--beige);
			border-radius: 18px 22px 16px 24px / 22px 16px 24px 18px;
			outline: none;
			transition: border-color 0.15s;
		}
		.zukan-search input:focus {
			border-color: var(--orange-light);
		}
		.zukan-search button {
			padding: 0.6em 1.3em;
			font-size: 0.85em;
			font-weight: 700;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			color: #fff;
			background: var(--orange);
			border: 2px solid var(--orange-dark);
			border-radius: 20px 24px 18px 26px / 24px 18px 26px 20px;
			cursor: pointer;
			white-space: nowrap;
			transition: opacity 0.15s;
		}
		.zukan-search button:hover {
			opacity: 0.85;
		}

		/* ── 扉が並ぶ廊下 ── */
		.room-section {
			padding: 1.4em 0 5em;
			background: var(--milk);
		}
		.room-section__inner {
			max-width: 980px;
			margin: 0 auto;
			padding: 0 1.2em;
		}
		.room-grid {
			display: grid;
			/* 部屋が増えても崩れないよう、幅に応じて自動で列数を決める */
			grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
			gap: 1.2rem;
			align-items: end;
		}

		/* ── 扉カード（枠なし・紙の上に扉が並ぶイメージ） ── */
		.room-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			text-decoration: none;
			color: inherit;
			transition: transform 0.2s;
		}
		.room-card:hover {
			transform: translateY(-6px);
			text-decoration: none;
		}
		.room-card :global(.crayon-door) {
			filter: drop-shadow(0 4px 7px rgba(120, 90, 50, 0.18));
			transition: filter 0.2s;
		}
		.room-card:hover :global(.crayon-door) {
			filter: drop-shadow(0 8px 13px rgba(120, 90, 50, 0.28));
		}
		.room-card__enter {
			display: inline-block;
			margin-top: 0.55em;
			padding: 0.35em 1.2em;
			border-radius: 30px 34px 28px 36px / 34px 28px 36px 30px;
			border: 1.5px solid var(--orange-light);
			color: var(--orange-dark);
			font-size: 0.72em;
			font-weight: 700;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			transition: background 0.18s, color 0.18s;
		}
		.room-card:hover .room-card__enter {
			background: var(--orange);
			color: #fff;
			border-color: var(--orange);
		}

		/* ── スマホ：扉を2〜3列でコンパクトに ── */
		@media (max-width: 700px) {
			.room-grid {
				grid-template-columns: repeat(3, 1fr);
				gap: 0.8rem;
			}
			.room-card__enter {
				margin-top: 0.5em;
				padding: 0.3em 0.9em;
				font-size: 0.68em;
			}
			.zukan-header { padding: 1.8em 1em 1.4em; }
			.zukan-header__title { font-size: 1.55em; }
			.room-section { padding: 1.8em 0 4em; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="zukan-header">
			<div class="zukan-header__inner">
				{toshoshitsuSignImage ? (
					<div class="zukan-header__sign">
						<img src={toshoshitsuSignImage} alt="図書室" />
					</div>
				) : (
					<h1 class="zukan-header__title-fallback">📚 図書室</h1>
				)}
				{interiorImage && (
					<div class="zukan-header__photo">
						<img src={interiorImage} alt="おうちの中の様子" />
					</div>
				)}
			</div>
		</div>

		<div class="zukan-search-wrap">
			<form class="zukan-search" action="/zukan/all" method="get">
				<input
					type="search"
					name="q"
					placeholder="グッズのなまえで探す（例：トトロ）"
					aria-label="図鑑からグッズを検索"
				/>
				<button type="submit">🔍 さがす</button>
			</form>
		</div>

		<section class="room-section">
			<div class="room-section__inner">
				<div class="room-grid">
					{rooms.map((room) => (
						<a class="room-card" href={`/zukan/${room.slug}`}>
							<CrayonDoor slug={`top-${room.slug}`} label={room.short} base={room.base} dark={room.dark} />
							<span class="room-card__enter">部屋に入る →</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</body>
</html>
