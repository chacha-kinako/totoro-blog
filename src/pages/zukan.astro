---
import BaseHead from '../components/BaseHead.astro';
import CrayonDoor from '../components/CrayonDoor.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const rooms = [
	{
		slug: 'figure',
		short: 'フィギア',
		name: 'フィギアの部屋',
		href: '/zukan/figure',
		desc: 'フィギュアたちが集合',
		base: '#D08B3E',
		dark: '#9C6420',
	},
	{
		slug: 'nuigurumi',
		short: 'ぬいぐるみ',
		name: 'ぬいぐるみの部屋',
		href: '/zukan/nuigurumi',
		desc: 'ふわふわの仲間たち',
		base: '#F2A9BC',
		dark: '#D97A94',
	},
	{
		slug: 'shokki',
		short: '食器',
		name: '食器の部屋',
		href: '/zukan/shokki',
		desc: 'マグやお皿など',
		base: '#64AAE8',
		dark: '#3B7EC0',
	},
	{
		slug: 'toki',
		short: '陶器',
		name: '陶器の部屋',
		href: '/zukan/toki',
		desc: '陶器の置物たち',
		base: '#A5C86B',
		dark: '#7BA344',
	},
	{
		slug: 'all',
		short: '総合部屋',
		name: '総合部屋',
		href: '/zukan/all',
		desc: '全グッズを一覧で',
		base: '#F5C845',
		dark: '#D19E1D',
	},
];
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`図書室 | ${SITE_TITLE}`} description="トトロ・ジブリグッズの図鑑。コレクションを眺めて楽しむ場所です。" />
	<style>
		/* ── ページヘッダー ── */
		.zukan-header {
			text-align: center;
			padding: 2.6em 1em 1.8em;
			background: #fff;
		}
		.zukan-header__label {
			display: inline-block;
			font-size: 0.7em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			margin-bottom: 0.6em;
			padding: 0.3em 1.1em;
			border: 1.5px solid var(--orange-light);
			border-radius: 40px 46px 38px 48px / 46px 38px 48px 40px;
			background: var(--orange-pale);
		}
		.zukan-header__title {
			font-family: 'Yomogi', 'Kaisei Decol', 'Hiragino Maru Gothic ProN', serif;
			font-size: 2em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.4em;
			line-height: 1.3;
		}
		.zukan-header__desc {
			font-size: 0.88em;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.8;
		}

		/* ── 検索ボックス ── */
		.zukan-search {
			max-width: 480px;
			margin: 1.4em auto 0;
			display: flex;
			gap: 8px;
			padding: 0 1em;
		}
		.zukan-search input {
			flex: 1;
			min-width: 0;
			padding: 0.65em 1.1em;
			font-size: 16px;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			color: var(--text);
			background: #fffdf6;
			border: 2px solid var(--beige);
			border-radius: 18px 22px 16px 24px / 22px 16px 24px 18px;
			outline: none;
			transition: border-color 0.15s;
		}
		.zukan-search input:focus {
			border-color: var(--orange-light);
		}
		.zukan-search button {
			padding: 0.6em 1.3em;
			font-size: 0.85em;
			font-weight: 700;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			color: #fff;
			background: var(--orange);
			border: 2px solid var(--orange-dark);
			border-radius: 20px 24px 18px 26px / 24px 18px 26px 20px;
			cursor: pointer;
			white-space: nowrap;
			transition: opacity 0.15s;
		}
		.zukan-search button:hover {
			opacity: 0.85;
		}

		/* ── 扉が並ぶ廊下 ── */
		.room-section {
			padding: 2.6em 0 5em;
			background: var(--milk);
		}
		.room-section__inner {
			max-width: 980px;
			margin: 0 auto;
			padding: 0 1.2em;
		}
		.room-grid {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 1.2rem;
			align-items: end;
		}

		/* ── 扉カード（枠なし・紙の上に扉が並ぶイメージ） ── */
		.room-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			text-decoration: none;
			color: inherit;
			transition: transform 0.2s;
		}
		.room-card:hover {
			transform: translateY(-6px);
			text-decoration: none;
		}
		.room-card :global(.crayon-door) {
			filter: drop-shadow(0 4px 7px rgba(120, 90, 50, 0.18));
			transition: filter 0.2s;
		}
		.room-card:hover :global(.crayon-door) {
			filter: drop-shadow(0 8px 13px rgba(120, 90, 50, 0.28));
		}
		.room-card__desc {
			font-size: 0.72em;
			color: var(--text-muted);
			line-height: 1.5;
			margin-top: 0.7em;
		}
		.room-card__enter {
			display: inline-block;
			margin-top: 0.55em;
			padding: 0.35em 1.2em;
			border-radius: 30px 34px 28px 36px / 34px 28px 36px 30px;
			border: 1.5px solid var(--orange-light);
			color: var(--orange-dark);
			font-size: 0.72em;
			font-weight: 700;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			transition: background 0.18s, color 0.18s;
		}
		.room-card:hover .room-card__enter {
			background: var(--orange);
			color: #fff;
			border-color: var(--orange);
		}

		/* ── スマホ：扉を2〜3列でコンパクトに ── */
		@media (max-width: 700px) {
			.room-grid {
				grid-template-columns: repeat(3, 1fr);
				gap: 0.8rem;
			}
			.room-card__desc { display: none; }
			.room-card__enter {
				margin-top: 0.5em;
				padding: 0.3em 0.9em;
				font-size: 0.68em;
			}
			.zukan-header { padding: 1.8em 1em 1.4em; }
			.zukan-header__title { font-size: 1.55em; }
			.room-section { padding: 1.8em 0 4em; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="zukan-header">
			<span class="zukan-header__label">LIBRARY</span>
			<h1 class="zukan-header__title">📚 図書室</h1>
			<p class="zukan-header__desc">
				コレクションを眺めて楽しむ場所です<br>
				扉を選んでなかを覗いてみてください
			</p>
			<form class="zukan-search" action="/zukan/all" method="get">
				<input
					type="search"
					name="q"
					placeholder="グッズのなまえで探す（例：トトロ）"
					aria-label="図鑑からグッズを検索"
				/>
				<button type="submit">🔍 さがす</button>
			</form>
		</div>

		<section class="room-section">
			<div class="room-section__inner">
				<div class="room-grid">
					{rooms.map((room) => (
						<a class="room-card" href={room.href}>
							<CrayonDoor slug={`top-${room.slug}`} label={room.short} base={room.base} dark={room.dark} />
							<span class="room-card__desc">{room.desc}</span>
							<span class="room-card__enter">部屋に入る →</span>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</body>
</html>
