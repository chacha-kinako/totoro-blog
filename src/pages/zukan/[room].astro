---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import zukanDataRaw from '../../data/zukan.json';

type ZukanItem = {
	id: string;
	name?: string;
	comment?: string;
	image: string;
	reviewLink: string;
	affiliateLink: string;
	room?: string;
};

export function getStaticPaths() {
	return [
		{ params: { room: 'nuigurumi' }, props: { roomName: 'ぬいぐるみの部屋', roomIcon: '🧸', filter: 'ぬいぐるみの部屋' } },
		{ params: { room: 'toki' },      props: { roomName: '陶器の部屋',       roomIcon: '🍵', filter: '陶器の部屋' } },
		{ params: { room: 'figure' },    props: { roomName: 'フィギアの部屋',   roomIcon: '🪆', filter: 'フィギアの部屋' } },
		{ params: { room: 'shokki' },    props: { roomName: '食器の部屋',       roomIcon: '🍽️', filter: '食器の部屋' } },
		{ params: { room: 'all' },       props: { roomName: '総合部屋',         roomIcon: '📦', filter: null } },
	];
}

const { roomName, roomIcon, filter } = Astro.props;
const currentRoom = Astro.params.room;

const allItems: ZukanItem[] = zukanDataRaw as ZukanItem[];
const items = filter ? allItems.filter((item) => item.room === filter) : allItems;

const rooms = [
	{ slug: 'all',       name: '全部屋',     icon: '📦', color: '#C9A97A' },
	{ slug: 'nuigurumi', name: 'ぬいぐるみ', icon: '🧸', color: '#B8956A' },
	{ slug: 'toki',      name: '陶器',       icon: '🍵', color: '#A8B882' },
	{ slug: 'figure',    name: 'フィギア',   icon: '🪆', color: '#A89DC8' },
	{ slug: 'shokki',    name: '食器',       icon: '🍽️', color: '#C4A882' },
];
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`${roomName} | 図鑑 | ${SITE_TITLE}`} description={`${roomName}のコレクション図鑑です。`} />
	<style>
		/* ── ページヘッダー ── */
		.room-header {
			text-align: center;
			padding: 2.2em 1em 1.5em;
			background: #fff;
		}
		.room-header__label {
			font-size: 0.7em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			display: block;
			margin-bottom: 0.5em;
		}
		.room-header__title {
			font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
			font-size: 1.8em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.35em;
			line-height: 1.3;
		}
		.room-header__desc {
			font-size: 0.86em;
			color: var(--text-muted);
			margin: 0;
		}

		/* ── 2カラムレイアウト ── */
		.zukan-outer {
			max-width: 1220px;
			margin: 0 auto;
			padding: 0 1em 5em;
			display: flex;
			gap: 0;
			align-items: flex-start;
		}

		/* ── 左：カードエリア ── */
		.zukan-main {
			flex: 1;
			min-width: 0;
			padding: 0 1em;
		}
		.zukan-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 14px;
			margin-top: 1.2em;
		}
		@media (max-width: 900px) {
			.zukan-grid { grid-template-columns: repeat(3, 1fr); }
		}
		@media (max-width: 560px) {
			.zukan-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
		}

		/* ── カード ── */
		.zukan-card {
			background: #fff;
			border-radius: 12px;
			overflow: hidden;
			box-shadow: var(--shadow-sm);
			border: 1px solid var(--beige-light);
			transition: box-shadow 0.2s, transform 0.2s;
		}
		.zukan-card:hover {
			box-shadow: var(--shadow-hover);
			transform: translateY(-2px);
		}
		.zukan-card__img {
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: hidden;
			background: var(--milk-dark);
		}
		.zukan-card__img img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.25s;
		}
		.zukan-card:hover .zukan-card__img img { transform: scale(1.04); }
		.zukan-card__info {
			padding: 6px 8px 2px;
		}
		.zukan-card__name {
			font-size: 0.75em;
			font-weight: 700;
			color: var(--text);
			line-height: 1.4;
			margin-bottom: 2px;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.zukan-card__comment {
			font-size: 0.68em;
			color: var(--text-muted);
			line-height: 1.4;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.zukan-card__links {
			padding: 6px 8px 8px;
			display: flex;
			flex-direction: column;
			gap: 5px;
		}
		.zukan-btn {
			display: block;
			text-align: center;
			padding: 7px 6px;
			border-radius: 6px;
			font-size: 0.72em;
			font-weight: 700;
			text-decoration: none;
			line-height: 1.3;
			transition: opacity 0.15s;
		}
		.zukan-btn:hover { opacity: 0.8; text-decoration: none; }
		.zukan-btn--review {
			background: var(--orange-pale);
			color: var(--orange-dark);
			border: 1px solid var(--orange-light);
		}
		.zukan-btn--buy {
			background: var(--green-pale);
			color: var(--green-dark);
			border: 1px solid var(--green-light);
		}
		.zukan-empty {
			grid-column: 1 / -1;
			text-align: center;
			padding: 4em 2em;
			color: var(--text-muted);
			font-size: 0.9em;
			line-height: 2.2;
		}

		/* ── 右：扉サイドバー ── */
		.room-sidebar {
			width: 130px;
			flex-shrink: 0;
			position: sticky;
			top: 80px;
			padding-top: 1.2em;
		}
		.room-sidebar__title {
			font-size: 0.64em;
			font-weight: 700;
			color: var(--text-muted);
			letter-spacing: 0.12em;
			text-align: center;
			margin: 0 0 0.9em;
		}
		.room-door-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		/* ── 扉カード本体 ── */
		.room-door {
			display: block;
			text-decoration: none;
			position: relative;
			width: 100%;
		}
		.room-door:hover { text-decoration: none; }

		/* 扉SVG */
		.door-svg {
			width: 100%;
			display: block;
			filter: drop-shadow(0 3px 6px rgba(0,0,0,0.18));
			transition: filter 0.2s, transform 0.2s;
		}
		.room-door:hover .door-svg {
			filter: drop-shadow(0 5px 10px rgba(0,0,0,0.28));
			transform: translateY(-2px);
		}
		.room-door--active .door-svg {
			filter: drop-shadow(0 4px 8px rgba(196,113,74,0.45));
		}

		/* プレートはSVG内に埋め込むためCSS側は不要 */

		@media (max-width: 860px) {
			.zukan-outer { flex-direction: column; padding: 0 0.8em 4em; }
			.room-sidebar {
				width: 100%;
				position: static;
				order: -1;
				padding-top: 0.5em;
			}
			.room-door-list {
				flex-direction: row;
				flex-wrap: wrap;
				gap: 8px;
			}
			.room-door {
				width: calc(20% - 7px);
				min-width: 70px;
			}
			.zukan-main { padding: 0; }
		}
		@media (max-width: 560px) {
			.room-door { width: calc(33.33% - 6px); }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="room-header">
			<span class="room-header__label">ZUKAN</span>
			<h1 class="room-header__title">{roomIcon} {roomName}</h1>
			<p class="room-header__desc">{items.length > 0 ? `${items.length}点のコレクション` : '準備中です'}</p>
		</div>

		<div class="zukan-outer">
			<!-- 左：カードグリッド -->
			<div class="zukan-main">
				<div class="zukan-grid">
					{items.length === 0 && (
						<div class="zukan-empty">
							<p>🌱 まだコレクションがありません<br>少しまってね！</p>
						</div>
					)}
					{items.map((item) => (
						<div class="zukan-card">
							<div class="zukan-card__img">
								<img src={item.image} alt={item.name ?? 'グッズ画像'} loading="lazy" />
							</div>
							{(item.name || item.comment) && (
								<div class="zukan-card__info">
									{item.name && <div class="zukan-card__name">{item.name}</div>}
									{item.comment && <div class="zukan-card__comment">{item.comment}</div>}
								</div>
							)}
							<div class="zukan-card__links">
								{item.reviewLink && (
									<a href={item.reviewLink} class="zukan-btn zukan-btn--review">
										レビュー記事
									</a>
								)}
								{item.affiliateLink && (
									<a href={item.affiliateLink} class="zukan-btn zukan-btn--buy"
									   target="_blank" rel="noopener noreferrer nofollow">
										購入はこちら
									</a>
								)}
							</div>
						</div>
					))}
				</div>
			</div>

			<!-- 右：部屋の扉 -->
			<aside class="room-sidebar">
				<p class="room-sidebar__title">— 部屋を選ぶ —</p>
				<ul class="room-door-list">
					{rooms.map((r) => (
						<li>
							<a
								href={`/zukan/${r.slug}`}
								class={`room-door${currentRoom === r.slug ? ' room-door--active' : ''}`}
							>
								<!-- 扉SVG（アーチ型・木目・吊り下げプレート） -->
								<svg class="door-svg" viewBox="0 0 100 138" xmlns="http://www.w3.org/2000/svg">
									<defs>
										<clipPath id={`arch-${r.slug}`}>
											<path d="M8,50 Q8,10 50,10 Q92,10 92,50 L92,130 Q92,134 88,134 L12,134 Q8,134 8,130 Z" />
										</clipPath>
										<linearGradient id={`woodgrad-${r.slug}`} x1="0" y1="0" x2="1" y2="0">
											<stop offset="0%" stop-color="rgba(0,0,0,0.10)"/>
											<stop offset="40%" stop-color="rgba(255,255,255,0.08)"/>
											<stop offset="100%" stop-color="rgba(0,0,0,0.12)"/>
										</linearGradient>
									</defs>

									<!-- 扉本体（アーチ型） -->
									<path d="M8,50 Q8,10 50,10 Q92,10 92,50 L92,130 Q92,134 88,134 L12,134 Q8,134 8,130 Z" fill={r.color} />

									<!-- 木目ライン -->
									<g clip-path={`url(#arch-${r.slug})`} opacity="0.22">
										<line x1="25" y1="10" x2="22" y2="134" stroke="rgba(0,0,0,0.5)" stroke-width="1.4"/>
										<line x1="36" y1="10" x2="34" y2="134" stroke="rgba(255,255,255,0.4)" stroke-width="0.7"/>
										<line x1="48" y1="10" x2="47" y2="134" stroke="rgba(0,0,0,0.4)" stroke-width="1.1"/>
										<line x1="60" y1="10" x2="59" y2="134" stroke="rgba(255,255,255,0.35)" stroke-width="0.8"/>
										<line x1="72" y1="10" x2="71" y2="134" stroke="rgba(0,0,0,0.4)" stroke-width="1.2"/>
										<line x1="83" y1="18" x2="82" y2="134" stroke="rgba(255,255,255,0.3)" stroke-width="0.6"/>
									</g>

									<!-- 側面の影（立体感） -->
									<path d="M8,50 Q8,10 50,10 Q92,10 92,50 L92,130 Q92,134 88,134 L12,134 Q8,134 8,130 Z" fill={`url(#woodgrad-${r.slug})`} />

									<!-- 枠線 -->
									<path d="M8,50 Q8,10 50,10 Q92,10 92,50 L92,130 Q92,134 88,134 L12,134 Q8,134 8,130 Z"
										fill="none" stroke="rgba(0,0,0,0.28)" stroke-width="2.5" />

									<!-- ドアノブ（丸・右側） -->
									<circle cx="75" cy="95" r="5" fill="#D8D0C0" stroke="rgba(0,0,0,0.2)" stroke-width="1"/>
									<circle cx="75" cy="95" r="3" fill="#B8B0A0"/>
									<circle cx="74" cy="94" r="1.2" fill="rgba(255,255,255,0.5)"/>

									<!-- 吊り下げプレートの紐 -->
									<line x1="38" y1="32" x2="38" y2="44" stroke="#8B7355" stroke-width="1.2"/>
									<line x1="62" y1="32" x2="62" y2="44" stroke="#8B7355" stroke-width="1.2"/>
									<!-- 紐の留め具（小さい丸） -->
									<circle cx="38" cy="31" r="2" fill="#8B7355"/>
									<circle cx="62" cy="31" r="2" fill="#8B7355"/>

									<!-- 吊り下げプレート本体 -->
									<rect x="26" y="44" width="48" height="32" rx="4" fill="#EDE0C4" stroke="#C8A96E" stroke-width="1.5"/>
									<rect x="28" y="46" width="44" height="28" rx="3" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.8"/>

									<!-- プレート内：アイコンとテキスト（foreignObject） -->
									<text x="50" y="60" text-anchor="middle" font-size="11" dominant-baseline="middle">{r.icon}</text>
									<text x="50" y="72" text-anchor="middle" font-size="6.5" fill="#5C3D1E" font-weight="bold" font-family="sans-serif" dominant-baseline="middle">{r.name}</text>
								</svg>
							</a>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</main>
	<Footer />
</body>
</html>
