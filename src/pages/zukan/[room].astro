---
import BaseHead from '../../components/BaseHead.astro';
import CrayonDoor from '../../components/CrayonDoor.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import zukanDataRaw from '../../data/zukan.json';
import { getAllGenteiIds } from '../../zukan-gentei';
import { getZukanRooms } from '../../zukan-rooms';

type ZukanItem = {
	id: string;
	name?: string;
	comment?: string;
	image: string;
	reviewLink: string;
	affiliateLink: string;
	/** true = そのものではなく「にた商品」のリンク */
	affiliateAlt?: boolean;
	room?: string;
	roomSlug?: string;
	simple?: boolean;
	price?: number | null;
};

// 部屋は rooms.json（管理室が更新）から自動生成。部屋を増やすとこのページも自動で増える
export function getStaticPaths() {
	return getZukanRooms().map((r) => ({
		params: { room: r.slug },
		props: {
			roomName: r.name,
			roomIcon: r.emoji,
			filter: r.slug === 'all' ? null : r.slug,
			filterName: r.slug === 'all' ? null : r.name,
		},
	}));
}

const { roomName, roomIcon, filter, filterName } = Astro.props;
const currentRoom = Astro.params.room;

// simple = レビュー記事から自動生成した簡易カード。図書室の図鑑には出さない（部屋トップ専用）
const allItems: ZukanItem[] = (zukanDataRaw as ZukanItem[]).filter((item) => !item.simple);
// 限定の扉のグッズは限定の扉だけで見せる（総合部屋には混ぜない）
const genteiIds = getAllGenteiIds();
const items = filter
	? allItems.filter((item) => (item.roomSlug ? item.roomSlug === filter : item.room === filterName))
	: allItems.filter((item) => !genteiIds.has(item.id));

const rooms = getZukanRooms().map((r) => ({ slug: r.slug, name: r.short, base: r.base, dark: r.dark }));
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`${roomName} | 図鑑 | ${SITE_TITLE}`} description={`${roomName}のコレクション図鑑です。`} />
	<style>
		/* ── ページヘッダー ── */
		.room-header {
			text-align: center;
			padding: 1.2em 1em 0.9em;
			background: #fff;
		}
		.room-header__label {
			font-size: 0.7em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			display: block;
			margin-bottom: 0.5em;
		}
		.room-header__title {
			font-family: 'Yomogi', 'Kaisei Decol', 'Hiragino Maru Gothic ProN', serif;
			font-size: 1.8em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.35em;
			line-height: 1.3;
		}

		/* ── 検索ボックス ── */
		.zukan-search-row {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			margin-top: 1.2em;
			padding: 0 1em;
		}
		.zukan-search-row input {
			flex: 1;
			min-width: 0;
			max-width: 420px;
			padding: 0.6em 1.1em;
			font-size: 16px;
			font-family: 'Yomogi', 'Hiragino Maru Gothic ProN', sans-serif;
			color: var(--text);
			background: #fffdf6;
			border: 2px solid var(--beige);
			border-radius: 18px 22px 16px 24px / 22px 16px 24px 18px;
			outline: none;
			transition: border-color 0.15s;
		}
		.zukan-search-row input:focus {
			border-color: var(--orange-light);
		}
		.zukan-search-row .zukan-search-count {
			font-size: 0.78em;
			font-weight: 700;
			color: var(--orange-dark);
			white-space: nowrap;
		}
		.room-header__desc {
			font-size: 0.86em;
			color: var(--text-muted);
			margin: 0;
		}

		/* ── 2カラムレイアウト ── */
		.zukan-outer {
			max-width: 1220px;
			margin: 0 auto;
			padding: 0 1em 5em;
			display: flex;
			gap: 0;
			align-items: flex-start;
		}

		/* ── 左：カードエリア ── */
		.zukan-main {
			flex: 1;
			min-width: 0;
			padding: 0 1em;
		}
		/* 限定の扉（GenteiPage）と同じ大きさ。写真がずらっと並ぶことを優先 */
		.zukan-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 12px;
			margin-top: 1.2em;
		}

		/* ── カード（写真・名前・値段を押すとレビューへ／下の細いボタンで在庫を確認） ── */
		.zukan-card {
			display: flex;
			flex-direction: column;
			background: #fff;
			border-radius: 12px;
			overflow: hidden;
			box-shadow: var(--shadow-sm);
			border: 2px solid var(--beige-light);
			transition: box-shadow 0.2s, transform 0.2s;
		}
		.zukan-card:hover {
			box-shadow: var(--shadow-hover);
			transform: translateY(-2px);
		}
		.zukan-card__main {
			display: block;
			flex: 1;
			color: inherit;
			text-decoration: none;
		}
		.zukan-card__main:hover { text-decoration: none; }
		.zukan-card__img {
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: hidden;
			background: var(--milk-dark);
		}
		.zukan-card__img img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.25s;
		}
		.zukan-card:hover .zukan-card__img img { transform: scale(1.04); }
		.zukan-card__info { padding: 6px 8px 6px; }
		.zukan-card__name {
			font-size: 0.74em;
			font-weight: 700;
			color: var(--text);
			line-height: 1.4;
			min-height: 2.8em;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.zukan-card__price {
			margin-top: 2px;
			font-size: 0.68em;
			font-weight: 700;
			color: var(--orange-dark);
		}
		.zukan-card__buy {
			display: block;
			margin: 0 6px 6px;
			padding: 4px 4px;
			text-align: center;
			font-size: 0.66em;
			font-weight: 700;
			line-height: 1.3;
			color: var(--green-dark);
			background: var(--green-pale);
			border: 1px solid var(--green-light);
			border-radius: 6px;
			text-decoration: none;
			transition: opacity 0.15s;
		}
		.zukan-card__buy:hover { opacity: 0.8; text-decoration: none; }
		@media (max-width: 560px) {
			/* スマホは3列で写真をぎゅっと並べる */
			.zukan-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
			.zukan-card { border-width: 1.5px; border-radius: 9px; }
			.zukan-card__info { padding: 4px 5px 5px; }
			.zukan-card__name { font-size: 0.66em; }
			.zukan-card__price { font-size: 0.62em; }
			.zukan-card__buy { margin: 0 4px 4px; padding: 3px 2px; font-size: 0.6em; }
		}
		.zukan-empty {
			grid-column: 1 / -1;
			text-align: center;
			padding: 4em 2em;
			color: var(--text-muted);
			font-size: 0.9em;
			line-height: 2.2;
		}

		/* ── 右：扉サイドバー ── */
		.room-sidebar {
			width: 130px;
			flex-shrink: 0;
			position: sticky;
			top: 80px;
			padding-top: 1.2em;
		}
		.room-sidebar__title {
			font-size: 0.64em;
			font-weight: 700;
			color: var(--text-muted);
			letter-spacing: 0.12em;
			text-align: center;
			margin: 0 0 0.9em;
		}
		.room-door-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		/* ── 扉カード本体 ── */
		.room-door {
			display: block;
			text-decoration: none;
			position: relative;
			width: 100%;
		}
		.room-door:hover { text-decoration: none; }

		/* 扉SVG（クレヨン手書き風コンポーネント） */
		.room-door :global(.crayon-door) {
			filter: drop-shadow(0 3px 6px rgba(120, 90, 50, 0.2));
			transition: filter 0.2s, transform 0.2s;
		}
		.room-door:hover :global(.crayon-door) {
			filter: drop-shadow(0 5px 10px rgba(120, 90, 50, 0.3));
			transform: translateY(-2px);
		}
		.room-door--active :global(.crayon-door) {
			filter: drop-shadow(0 4px 9px rgba(196, 113, 74, 0.5));
			transform: scale(1.04);
		}

		@media (max-width: 860px) {
			.zukan-outer { flex-direction: column; padding: 0 0.8em 4em; }
			.room-sidebar {
				width: 100%;
				position: static;
				order: -1;
				padding-top: 0.5em;
			}
			.room-door-list {
				flex-direction: row;
				flex-wrap: wrap;
				justify-content: center;
				gap: 6px;
			}
			.room-door-list li {
				width: calc(20% - 5px);
				min-width: 52px;
				max-width: 110px;
			}
			.room-door {
				width: 100%;
			}
			.zukan-main { padding: 0; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="room-header">
			<span class="room-header__label">ZUKAN</span>
			<h1 class="room-header__title">{roomIcon} {roomName}</h1>
			<p class="room-header__desc">{items.length > 0 ? `${items.length}点のコレクション` : '準備中です'}</p>
			<div class="zukan-search-row">
				<input
					id="zukan-q"
					type="search"
					placeholder="🔍 なまえで探す"
					aria-label="この部屋のグッズを検索"
				/>
				<span class="zukan-search-count" id="zukan-q-count"></span>
			</div>
		</div>

		<div class="zukan-outer">
			<!-- 左：カードグリッド -->
			<div class="zukan-main">
				<div class="zukan-grid">
					{items.length === 0 && (
						<div class="zukan-empty">
							<p>🌱 まだコレクションがありません<br>少しまってね！</p>
						</div>
					)}
					<div class="zukan-empty" id="zukan-q-empty" style="display:none">
						<p>🔍 みつかりませんでした…<br>ことばを変えてためしてみてね</p>
					</div>
					{items.map((item) => (
						<div class="zukan-card" data-search={(item.name ?? '').toLowerCase()}>
							<a class="zukan-card__main" href={item.reviewLink || '/zukan/'}>
								<div class="zukan-card__img">
									<img src={item.image} alt={item.name ?? 'グッズ画像'} loading="lazy" />
								</div>
								<div class="zukan-card__info">
									<div class="zukan-card__name">{item.name}</div>
									{item.price != null && <div class="zukan-card__price">¥{item.price.toLocaleString()}</div>}
								</div>
							</a>
							{item.affiliateLink && (
								<a href={item.affiliateLink} class="zukan-card__buy"
								   target="_blank" rel="noopener noreferrer nofollow">
									{item.affiliateAlt ? "🛒 にた商品をみる" : "🛒 在庫を確認"}
								</a>
							)}
						</div>
					))}
				</div>
			</div>

			<!-- 右：部屋の扉 -->
			<aside class="room-sidebar">
				<p class="room-sidebar__title">— 部屋を選ぶ —</p>
				<ul class="room-door-list">
					{rooms.map((r) => (
						<li>
							<a
								href={`/zukan/${r.slug}`}
								class={`room-door${currentRoom === r.slug ? ' room-door--active' : ''}`}
							>
								<CrayonDoor slug={`side-${r.slug}`} label={r.name} base={r.base} dark={r.dark} />
							</a>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</main>
	<Footer />

	<!-- 図鑑の検索（このページ内のカードをその場で絞り込む） -->
	<script is:inline>
		(function () {
			var input = document.getElementById('zukan-q');
			var countEl = document.getElementById('zukan-q-count');
			var emptyEl = document.getElementById('zukan-q-empty');
			if (!input) return;
			var cards = Array.prototype.slice.call(document.querySelectorAll('.zukan-card'));

			function apply() {
				var q = input.value.trim().toLowerCase();
				var hit = 0;
				cards.forEach(function (c) {
					var ok = !q || (c.getAttribute('data-search') || '').indexOf(q) !== -1;
					c.style.display = ok ? '' : 'none';
					if (ok) hit++;
				});
				if (countEl) countEl.textContent = q ? hit + '件ヒット' : '';
				if (emptyEl) emptyEl.style.display = q && hit === 0 ? '' : 'none';
			}

			input.addEventListener('input', apply);

			// 図鑑TOPの検索ボックスから ?q=◯◯ で来たとき
			var q0 = new URLSearchParams(location.search).get('q');
			if (q0) {
				input.value = q0;
				apply();
			}
		})();
	</script>
</body>
</html>
