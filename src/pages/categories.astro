---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE } from '../consts';

const categories = [
	{ icon: '💎', name: 'コレクション',      desc: 'お気に入りを集めて',             href: '/categories/コレクション' },
	{ icon: '✨', name: 'おすすめ・まとめ',   desc: '迷ったらここから',               href: '/categories/おすすめ・まとめ' },
	{ icon: '🎁', name: '今月の仲間入り',    desc: '新しく迎えたグッズ紹介',          href: '/categories/今月の仲間入り' },
	{ icon: '📖', name: 'お小遣い帳',        desc: 'リアルな収支公開',              href: '/categories/お小遣い帳' },
	{ icon: '🛍️', name: 'グッズ購入のいろは', desc: '選び方・購入場所ガイド',         href: '/categories/グッズ購入のいろは' },
	{ icon: '🪆', name: 'フィギア',          desc: 'フィギアレビュー',               href: '/categories/フィギア' },
	{ icon: '🍵', name: '陶器',             desc: '陶器レビュー',                   href: '/categories/陶器' },
	{ icon: '🍽️', name: '食器',             desc: '食器レビュー',                   href: '/categories/食器' },
	{ icon: '📦', name: '総合',             desc: 'ジャンル混合の記事',              href: '/categories/総合' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`カテゴリ | ${SITE_TITLE}`} description="ジブリグッズブログのカテゴリ一覧です。お好みのカテゴリからお探しください。" />
		<style>
			.page-outer {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5em;
				display: flex;
				gap: 2.5em;
				align-items: flex-start;
			}
			.page-main {
				flex: 1;
				min-width: 0;
			}
			.page-heading {
				padding: 2.2em 0 1.8em;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: var(--font-hand);
				font-size: 1.6em;
				font-weight: 700;
				color: var(--blue-ink);
				margin: 0;
				line-height: 1.3;
			}

			.category-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0 0 4em;
			}
			.category-card {
				background: var(--milk);
				border: 2px solid var(--beige-light);
				border-radius: 18px 14px 20px 12px / 14px 20px 12px 18px;
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
			}
			.category-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-md);
				border-color: var(--orange-light);
				background: #fff;
			}
			.category-card a {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1.6em 0.8em 1.5em;
				gap: 0.35em;
				text-decoration: none;
				color: inherit;
			}
			.category-card__icon {
				font-size: 2em;
				line-height: 1;
				margin-bottom: 0.2em;
			}
			.category-card__name {
				font-size: 0.82em;
				font-weight: 700;
				color: var(--text);
				line-height: 1.4;
			}
			.category-card__desc {
				font-size: 0.68em;
				color: var(--text-muted);
				line-height: 1.35;
			}
			.category-card__bar {
				height: 3px;
				background: var(--mustard-light);
			}

			@media (max-width: 860px) {
				.page-outer { padding: 0 1em; }
			}
			@media (max-width: 600px) {
				.category-grid { grid-template-columns: repeat(2, 1fr); }
				.page-heading { padding: 1.5em 0 1.2em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-outer">
			<main class="page-main">
				<div class="page-heading">
					<span class="page-heading__label">CATEGORIES</span>
					<h1 class="page-heading__title">カテゴリから探す</h1>
				</div>
				<ul class="category-grid">
					{categories.map((cat) => (
						<li class="category-card">
							<div class="category-card__bar" />
							<a href={cat.href}>
								<span class="category-card__icon">{cat.icon}</span>
								<span class="category-card__name">{cat.name}</span>
								<span class="category-card__desc">{cat.desc}</span>
							</a>
						</li>
					))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
