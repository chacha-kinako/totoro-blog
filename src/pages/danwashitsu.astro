---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE } from '../consts';
import siteConfig from '../data/site-config.json';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const guidePosts = allPosts.filter((p) => p.data.articleType === 'guide');
const tokushuPosts = allPosts.filter(
	(p) => ['tokushu', 'hikaku', 'matome'].includes(p.data.articleType ?? '') && !p.data.room,
);
const zatsudanPosts = allPosts.filter((p) => p.data.articleType === 'zatsudan');

const sections = [
	{ key: 'guide', icon: '☕', title: '購入ガイド', posts: guidePosts },
	{ key: 'tokushu', icon: '🌟', title: '特集', posts: tokushuPosts },
	{ key: 'zatsudan', icon: '💬', title: 'ジブリ雑談', posts: zatsudanPosts },
].filter((s) => s.posts.length > 0);

const interiorImage = siteConfig.hero?.interiorImage ?? '';
const danwashitsuSignImage = siteConfig.hero?.danwashitsuSignImage ?? '/images/danwashitsu-sign.png';
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`談話室 | ${SITE_TITLE}`} description="購入ガイド・特集・ジブリ雑談など、のんびりおしゃべりする場所です。" />
	<style>
		.danwa-header {
			padding: 1.2em 1.2em 0.6em;
		}
		.danwa-header__inner {
			max-width: 1100px;
			margin: 0 auto;
			display: flex;
			align-items: center;
			gap: 2em;
		}
		.danwa-header__sign {
			width: min(30%, 320px);
			flex-shrink: 0;
		}
		.danwa-header__sign img {
			width: 100%;
			height: auto;
			display: block;
		}
		.danwa-header__photo {
			flex: 1;
			min-width: 0;
		}
		.danwa-header__photo img {
			width: 100%;
			height: auto;
			max-height: 420px;
			display: block;
			border-radius: 22px 26px 20px 24px / 24px 20px 26px 22px;
			border: 3px solid var(--wood-light);
			box-shadow: var(--shadow-md);
			object-fit: cover;
		}
		.danwa-header__title-fallback {
			text-align: center;
			font-family: 'Yomogi', 'Kaisei Decol', 'Hiragino Maru Gothic ProN', serif;
			font-size: 1.5em;
			font-weight: 700;
			color: var(--text);
			margin: 0;
		}
		@media (max-width: 700px) {
			.danwa-header__inner {
				flex-direction: column;
				gap: 1em;
			}
			.danwa-header__sign {
				width: min(60%, 220px);
			}
			.danwa-header__photo img {
				max-height: 220px;
			}
		}

		.page-outer {
			max-width: 1320px;
			margin: 0 auto;
			padding: 0.6em 0.5em 5em 1.5em;
			display: flex;
			gap: 4em;
			align-items: flex-start;
		}
		.page-main { flex: 1; min-width: 0; padding: 0 1.5em; }

		.danwa-section { margin-bottom: 2.4em; }
		.danwa-section__title {
			font-family: var(--font-hand);
			font-size: 1.2em;
			font-weight: 700;
			color: var(--blue-ink);
			margin: 0 0 0.8em;
			padding-bottom: 0.3em;
			border-bottom: 2px dashed var(--beige);
		}
		.danwa-list {
			display: flex;
			flex-direction: column;
			gap: 1em;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.danwa-item {
			display: flex;
			gap: 1.2em;
			align-items: center;
			background: #fff;
			border: 2px solid var(--beige-light);
			border-radius: 20px 16px 22px 14px / 16px 22px 14px 20px;
			box-shadow: var(--shadow-sm);
			padding: 1.1em 1.4em;
			text-decoration: none;
			color: inherit;
			transition: transform 0.2s, box-shadow 0.2s;
		}
		.danwa-item:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-hover);
			text-decoration: none;
		}
		.danwa-item__icon { font-size: 1.8em; flex-shrink: 0; }
		.danwa-item__date {
			font-size: 0.7em;
			color: var(--text-muted);
			font-weight: 600;
			margin-bottom: 0.3em;
		}
		.danwa-item__title {
			font-size: 0.94em;
			font-weight: 700;
			font-family: var(--font-hand);
			color: var(--blue-ink);
			line-height: 1.6;
			margin: 0;
		}
		.danwa-empty {
			text-align: center;
			color: var(--text-muted);
			padding: 3em 1em;
			line-height: 2;
		}

		@media (max-width: 860px) {
			.page-outer { flex-direction: column; padding: 1.8em 1em 4em; gap: 1.5em; }
			.page-main { padding: 0; }
		}
	</style>
</head>
<body>
	<Header />
	<main>
		<div class="danwa-header">
			<div class="danwa-header__inner">
				{danwashitsuSignImage ? (
					<div class="danwa-header__sign">
						<img src={danwashitsuSignImage} alt="談話室" />
					</div>
				) : (
					<h1 class="danwa-header__title-fallback">☕ 談話室</h1>
				)}
				{interiorImage && (
					<div class="danwa-header__photo">
						<img src={interiorImage} alt="おうちの中の様子" />
					</div>
				)}
			</div>
		</div>

		<div class="page-outer">
			<div class="page-main">
				{sections.length === 0 ? (
					<p class="danwa-empty">🌱 まだ談話室の記事がありません<br>少しまってね！</p>
				) : (
					sections.map((s) => (
						<section class="danwa-section">
							<h2 class="danwa-section__title">{s.icon} {s.title}</h2>
							<ul class="danwa-list">
								{s.posts.map((post) => (
									<li>
										<a class="danwa-item" href={`/blog/${post.id}/`}>
											<span class="danwa-item__icon">{s.icon}</span>
											<span>
												<p class="danwa-item__date"><FormattedDate date={post.data.pubDate} /></p>
												<h3 class="danwa-item__title">{post.data.title}</h3>
											</span>
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				)}
			</div>
			<Sidebar />
		</div>
	</main>
	<Footer />
</body>
</html>
