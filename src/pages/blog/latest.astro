---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`最新の記事 | ${SITE_TITLE}`} description="ジブリグッズのレビューや暮らしの記録を最新順に一覧します。" />
		<style>
			.page-outer {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5em;
				display: flex;
				gap: 2.5em;
				align-items: flex-start;
			}
			.page-main {
				flex: 1;
				min-width: 0;
			}
			.page-heading {
				padding: 2.2em 0 1.8em;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
				font-size: 1.6em;
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.3;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.2rem;
				list-style: none;
				margin: 0;
				padding: 0 0 4em;
			}

			.post-card {
				background: #fff;
				border-radius: 16px;
				border: 1px solid var(--beige-light);
				box-shadow: var(--shadow-sm);
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-hover);
			}
			.post-card a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}
			.post-card__thumb {
				position: relative;
				width: 100%;
				aspect-ratio: 3 / 2;
				overflow: hidden;
			}
			.post-card__thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s;
			}
			.post-card:hover .post-card__thumb img { transform: scale(1.04); }
			.post-card__thumb-label {
				position: absolute;
				bottom: 0.7em;
				left: 0.8em;
				background: rgba(255,255,255,0.93);
				color: var(--orange-dark);
				font-family: 'Kaisei Decol', serif;
				font-size: 0.79em;
				font-weight: 700;
				padding: 0.25em 0.8em;
				border-radius: 50px;
				letter-spacing: 0.04em;
			}
			.post-card__bar {
				height: 4px;
				background: linear-gradient(90deg, var(--orange) 0%, var(--orange-light) 60%, var(--green-light) 100%);
			}
			.post-card__body {
				padding: 1.2em 1.3em 1.5em;
			}
			.post-card__date {
				font-size: 0.71em;
				color: var(--orange-light);
				font-weight: 600;
				margin-bottom: 0.4em;
			}
			.post-card__title {
				font-size: 0.88em;
				font-weight: 700;
				color: var(--text);
				line-height: 1.55;
				margin: 0 0 0.4em;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card__desc {
				font-size: 0.76em;
				color: var(--text-muted);
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 860px) {
				.page-outer { padding: 0 1em; }
			}
			@media (max-width: 720px) {
				.post-grid { grid-template-columns: 1fr; }
				.page-heading { padding: 1.5em 0 1.2em; }
			}
			@media (min-width: 721px) and (max-width: 860px) {
				.post-grid { grid-template-columns: repeat(2, 1fr); }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-outer">
			<main class="page-main">
				<div class="page-heading">
					<span class="page-heading__label">LATEST POSTS</span>
					<h1 class="page-heading__title">最新の記事</h1>
				</div>
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.cardImage ? (
										<>
											<div class="post-card__thumb">
												<img src={post.data.cardImage} alt={post.data.cardText ?? post.data.title} />
												{post.data.cardText && (
													<span class="post-card__thumb-label">{post.data.cardText}</span>
												)}
											</div>
											<div class="post-card__body">
												<p class="post-card__date"><FormattedDate date={post.data.pubDate} /></p>
												<h2 class="post-card__title">{post.data.title}</h2>
											</div>
										</>
									) : (
										<>
											<div class="post-card__bar" />
											<div class="post-card__body">
												<p class="post-card__date"><FormattedDate date={post.data.pubDate} /></p>
												<h2 class="post-card__title">{post.data.title}</h2>
												{post.data.description && (
													<p class="post-card__desc">{post.data.description}</p>
												)}
											</div>
										</>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
