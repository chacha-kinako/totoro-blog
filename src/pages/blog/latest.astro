---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const jaDate = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`最新の記事 | ${SITE_TITLE}`} description="ジブリグッズのレビューや暮らしの記録を最新順に一覧します。" />
		<style>
			.page-outer {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5em;
				display: flex;
				gap: 2.5em;
				align-items: flex-start;
			}
			.page-main {
				flex: 1;
				min-width: 0;
			}
			.page-heading {
				padding: 2.2em 0 1.8em;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: var(--font-hand);
				font-size: 1.6em;
				font-weight: 700;
				color: var(--blue-ink);
				margin: 0;
				line-height: 1.3;
			}

			.post-grid {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0 0 4em;
				max-width: 720px;
			}

			.post-card {
				background: #fff;
				border-radius: 20px 16px 22px 14px / 16px 22px 14px 20px;
				border: 2px solid var(--beige-light);
				box-shadow: var(--shadow-sm);
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.post-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-hover);
			}
			.post-card a {
				display: flex;
				flex-direction: row;
				align-items: stretch;
				text-decoration: none;
				color: inherit;
			}
			.post-card__thumb {
				position: relative;
				flex-shrink: 0;
				width: 150px;
				align-self: stretch;
				overflow: hidden;
			}
			.post-card__thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s;
				filter: url(#crayon-photo);
			}
			.post-card:hover .post-card__thumb img { transform: scale(1.04); }
			.post-card__thumb-label {
				position: absolute;
				bottom: 0.5em;
				left: 0.5em;
				right: 0.5em;
				background: rgba(255,255,255,0.93);
				color: var(--orange-dark);
				font-family: var(--font-hand);
				font-size: 0.7em;
				font-weight: 700;
				padding: 0.2em 0.7em;
				border-radius: 50px;
				letter-spacing: 0.03em;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.post-card__bar {
				flex-shrink: 0;
				width: 6px;
				background: var(--mustard-light);
			}
			.post-card__body {
				flex: 1;
				min-width: 0;
				padding: 0.9em 1.2em;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.3em;
			}
			.post-card__title {
				font-size: 0.78em;
				font-weight: 700;
				color: var(--blue-ink);
				font-family: var(--font-hand);
				line-height: 1.55;
				margin: 0;
				min-height: 3.1em;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card__date {
				align-self: flex-end;
				font-size: 0.68em;
				color: var(--text-muted);
				font-weight: 600;
			}
			.post-card__desc {
				font-size: 0.76em;
				color: var(--text-muted);
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 860px) {
				.page-outer { padding: 0 1em; }
			}
			@media (max-width: 720px) {
				.page-heading { padding: 1.5em 0 1.2em; }
				.post-card__thumb { width: 112px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-outer">
			<main class="page-main">
				<div class="page-heading">
					<span class="page-heading__label">LATEST POSTS</span>
					<h1 class="page-heading__title">最新の記事</h1>
				</div>
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.cardImage ? (
										<>
											<div class="post-card__thumb">
												<img src={post.data.cardImage} alt={post.data.cardText ?? post.data.title} />
												{post.data.cardText && (
													<span class="post-card__thumb-label">{post.data.cardText}</span>
												)}
											</div>
											<div class="post-card__body">
												<h2 class="post-card__title">{post.data.title}</h2>
												<p class="post-card__date">{jaDate(post.data.pubDate)}</p>
											</div>
										</>
									) : (
										<>
											<div class="post-card__bar" />
											<div class="post-card__body">
												<h2 class="post-card__title">{post.data.title}</h2>
												{post.data.description && (
													<p class="post-card__desc">{post.data.description}</p>
												)}
												<p class="post-card__date">{jaDate(post.data.pubDate)}</p>
											</div>
										</>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
