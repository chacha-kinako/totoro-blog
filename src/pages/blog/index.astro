---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description="トトロ・ジブリグッズのレビューや暮らしの記録をまとめた記事一覧です。" />
		<style>
			/* ページ見出し */
			.page-heading {
				padding: 2.2em 1.5em 1.8em;
				max-width: 960px;
				margin: 0 auto;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: 'Kaisei Decol', 'Hiragino Mincho ProN', serif;
				font-size: 1.6em;
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.3;
			}

			/* グリッド */
			.post-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.4rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-grid-wrap {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1.5em 4em;
			}

			/* カード共通 */
			.post-card {
				background: #fff;
				border-radius: 16px;
				border: 1px solid var(--beige-light);
				box-shadow: var(--shadow-sm);
				transition: transform 0.22s ease, box-shadow 0.22s ease;
				overflow: hidden;
			}
			.post-card:hover {
				transform: translateY(-5px);
				box-shadow: var(--shadow-hover);
			}
			.post-card a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}

			/* 写真ありカード */
			.post-card__thumb {
				position: relative;
				width: 100%;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				flex-shrink: 0;
			}
			.post-card__thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				display: block;
				transition: transform 0.3s ease;
			}
			.post-card:hover .post-card__thumb img {
				transform: scale(1.04);
			}

			/* テキストカード */
			.post-card__bar {
				height: 4px;
				background: linear-gradient(90deg, var(--orange) 0%, var(--orange-light) 60%, var(--green-light) 100%);
			}
			.post-card__body {
				padding: 1.2em 1.3em 1.5em;
			}
			.post-card__date {
				font-size: 0.78em;
				color: var(--orange-light);
				font-weight: 600;
				margin-bottom: 0.5em;
			}
			.post-card__title {
				font-size: 0.97em;
				font-weight: 700;
				color: var(--text);
				line-height: 1.45;
				margin: 0 0 0.6em;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card__desc {
				font-size: 0.82em;
				color: var(--text-muted);
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 600px) {
				.post-grid { grid-template-columns: 1fr; }
				.page-heading { padding: 1.5em 1em 1.2em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-heading">
				<span class="page-heading__label">ALL POSTS</span>
				<h1 class="page-heading__title">記事一覧</h1>
			</div>
			<div class="post-grid-wrap">
				<ul class="post-grid">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.cardImage ? (
										<>
											<div class="post-card__thumb">
												<img src={post.data.cardImage} alt={post.data.cardText ?? post.data.title} />
											</div>
											<div class="post-card__body">
												<p class="post-card__date">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h2 class="post-card__title">{post.data.title}</h2>
												{post.data.description && (
													<p class="post-card__desc">{post.data.description}</p>
												)}
											</div>
										</>
									) : (
										<>
											<div class="post-card__bar" />
											<div class="post-card__body">
												<p class="post-card__date">
													<FormattedDate date={post.data.pubDate} />
												</p>
												<h2 class="post-card__title">{post.data.title}</h2>
												{post.data.description && (
													<p class="post-card__desc">{post.data.description}</p>
												)}
											</div>
										</>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
