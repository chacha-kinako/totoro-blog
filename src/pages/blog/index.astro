---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';

const reviewCategories = [
	{
		icon: '🧸',
		name: 'ぬいぐるみ',
		desc: 'もふもふ、正直レビュー',
		href: `/categories/${encodeURIComponent('ぬいぐるみ')}`,
	},
	{
		icon: '🪆',
		name: 'フィギア',
		desc: 'ミニチュアの沼へようこそ',
		href: `/categories/${encodeURIComponent('フィギア')}`,
	},
	{
		icon: '🍵',
		name: '陶器',
		desc: '手仕事の温もり、じっくりレビュー',
		href: `/categories/${encodeURIComponent('陶器')}`,
	},
	{
		icon: '🍽️',
		name: '食器',
		desc: '食卓を彩るジブリグッズ',
		href: `/categories/${encodeURIComponent('食器')}`,
	},
	{
		icon: '📦',
		name: '総合',
		desc: 'まとめ・比較・シーン別おすすめ',
		href: `/categories/${encodeURIComponent('総合')}`,
	},
];
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={`レビュー | ${SITE_TITLE}`} description="ジブリグッズのレビューページ。陶器・マグ・フィギュア・ぬいぐるみなど種類別に見られます。" />
	<style>
		.page-outer {
			max-width: 1120px;
			margin: 0 auto;
			padding: 0 1.5em;
			display: flex;
			gap: 2.5em;
			align-items: flex-start;
		}
		.page-main {
			flex: 1;
			min-width: 0;
		}

		/* ── ページヘッダー ── */
		.page-heading {
			padding: 2.4em 0 2em;
		}
		.page-heading__label {
			font-size: 0.68em;
			font-weight: 700;
			color: var(--orange);
			letter-spacing: 0.22em;
			display: block;
			margin-bottom: 0.4em;
		}
		.page-heading__title {
			font-family: var(--font-hand);
			font-size: 1.6em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.4em;
			line-height: 1.3;
		}
		.page-heading__desc {
			font-size: 0.86em;
			color: var(--text-muted);
			margin: 0;
			line-height: 1.7;
		}

		/* ── カテゴリグリッド ── */
		.review-grid {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 1rem;
			padding-bottom: 5em;
		}

		/* ── カテゴリカード ── */
		.review-card {
			background: #fff;
			border-radius: 22px 18px 24px 16px / 18px 24px 16px 22px;
			border: 2px solid var(--beige);
			box-shadow: var(--shadow-sm);
			overflow: hidden;
			transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
		}
		.review-card:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-hover);
			border-color: var(--orange-light);
		}
		.review-card a {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 2em 1em 1.8em;
			text-decoration: none;
			color: inherit;
		}
		.review-card__icon {
			font-size: 2.4em;
			line-height: 1;
			margin-bottom: 0.5em;
		}
		.review-card__name {
			font-family: var(--font-hand);
			font-size: 0.92em;
			font-weight: 700;
			color: var(--text);
			margin-bottom: 0.4em;
			line-height: 1.35;
		}
		.review-card__desc {
			font-size: 0.72em;
			color: var(--text-muted);
			line-height: 1.5;
		}
		.review-card__bar {
			height: 3px;
			width: 100%;
			background: linear-gradient(90deg, var(--orange) 0%, var(--orange-light) 50%, var(--green-light) 100%);
		}

		@media (max-width: 860px) {
			.page-outer { padding: 0 1em; }
		}
		@media (max-width: 640px) {
			.review-grid { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
			.page-heading { padding: 1.6em 0 1.4em; }
		}
	</style>
</head>
<body>
	<Header />
	<div class="page-outer">
		<main class="page-main">
			<div class="page-heading">
				<span class="page-heading__label">REVIEWS</span>
				<h1 class="page-heading__title">✏️ レビュー</h1>
				<p class="page-heading__desc">実際の使用感・感想を種類別にまとめています</p>
			</div>

			<div class="review-grid">
				{reviewCategories.map((cat) => (
					<div class="review-card">
						<div class="review-card__bar" />
						<a href={cat.href}>
							<span class="review-card__icon">{cat.icon}</span>
							<span class="review-card__name">{cat.name}</span>
							<span class="review-card__desc">{cat.desc}</span>
						</a>
					</div>
				))}
			</div>
		</main>
		<Sidebar />
	</div>
	<Footer />
</body>
</html>
