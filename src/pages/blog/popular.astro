---
import { getCollection } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE } from '../../consts';

let pageOrder: Record<string, string[]> = {};
try {
	const p = join(process.cwd(), 'src/data/page-order.json');
	if (existsSync(p)) pageOrder = JSON.parse(readFileSync(p, 'utf-8'));
} catch {}

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
let posts = allPosts.filter(p => p.data.featured || p.data.showInPopular);

if (pageOrder.popular && pageOrder.popular.length > 0) {
	const order = pageOrder.popular;
	posts = [...posts].sort((a, b) => {
		const aSlug = a.id.replace(/\.(md|mdx)$/, '');
		const bSlug = b.id.replace(/\.(md|mdx)$/, '');
		const ai = order.indexOf(aSlug);
		const bi = order.indexOf(bSlug);
		if (ai === -1 && bi === -1) return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
		if (ai === -1) return 1;
		if (bi === -1) return -1;
		return ai - bi;
	});
}
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`人気の記事 | ${SITE_TITLE}`} description="とくにおすすめのジブリグッズ記事をまとめました。" />
		<style>
			.page-outer {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5em;
				display: flex;
				gap: 2.5em;
				align-items: flex-start;
			}
			.page-main {
				flex: 1;
				min-width: 0;
			}
			.page-heading {
				padding: 2.2em 0 1.8em;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: var(--font-hand);
				font-size: 1.6em;
				font-weight: 700;
				color: var(--blue-ink);
				margin: 0;
				line-height: 1.3;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.2rem;
				list-style: none;
				margin: 0;
				padding: 0 0 4em;
			}

			.empty-state {
				text-align: center;
				padding: 4em 1em;
				color: var(--text-muted);
				font-size: 0.9em;
			}

			.post-card {
				background: #fff;
				border-radius: 20px 16px 22px 14px / 16px 22px 14px 20px;
				border: 2px solid var(--beige-light);
				box-shadow: var(--shadow-sm);
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.post-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-hover);
			}
			.post-card a {
				display: block;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}
			.post-card__thumb {
				position: relative;
				width: 100%;
				aspect-ratio: 3 / 2;
				overflow: hidden;
			}
			.post-card__thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s;
				filter: url(#crayon-photo);
			}
			.post-card:hover .post-card__thumb img { transform: scale(1.04); }
			.post-card__thumb-label {
				position: absolute;
				bottom: 0.7em;
				left: 0.8em;
				background: rgba(255,255,255,0.93);
				color: var(--orange-dark);
				font-family: var(--font-hand);
				font-size: 0.79em;
				font-weight: 700;
				padding: 0.25em 0.8em;
				border-radius: 50px;
				letter-spacing: 0.04em;
			}
			.post-card__bar {
				height: 4px;
				background: var(--mustard-light);
			}
			.post-card__body {
				padding: 1.2em 1.3em 1.5em;
			}
			.post-card__date {
				font-size: 0.71em;
				color: var(--text-muted);
				font-weight: 600;
				margin-bottom: 0.4em;
			}
			.post-card__title {
				font-size: 0.88em;
				font-weight: 700;
				color: var(--blue-ink);
				font-family: var(--font-hand);
				line-height: 1.55;
				margin: 0 0 0.4em;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-card__desc {
				font-size: 0.76em;
				color: var(--text-muted);
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 860px) {
				.page-outer { padding: 0 1em; }
			}
			@media (max-width: 720px) {
				.post-grid { grid-template-columns: 1fr; }
				.page-heading { padding: 1.5em 0 1.2em; }
			}
			@media (min-width: 721px) and (max-width: 860px) {
				.post-grid { grid-template-columns: repeat(2, 1fr); }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-outer">
			<main class="page-main">
				<div class="page-heading">
					<span class="page-heading__label">POPULAR POSTS</span>
					<h1 class="page-heading__title">人気の記事</h1>
				</div>
				{posts.length > 0 ? (
					<ul class="post-grid">
						{posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									{post.data.cardImage ? (
										<>
											<div class="post-card__thumb">
												<img src={post.data.cardImage} alt={post.data.cardText ?? post.data.title} />
												{post.data.cardText && (
													<span class="post-card__thumb-label">{post.data.cardText}</span>
												)}
											</div>
											<div class="post-card__body">
												<p class="post-card__date"><FormattedDate date={post.data.pubDate} /></p>
												<h2 class="post-card__title">{post.data.title}</h2>
											</div>
										</>
									) : (
										<>
											<div class="post-card__bar" />
											<div class="post-card__body">
												<p class="post-card__date"><FormattedDate date={post.data.pubDate} /></p>
												<h2 class="post-card__title">{post.data.title}</h2>
												{post.data.description && (
													<p class="post-card__desc">{post.data.description}</p>
												)}
											</div>
										</>
									)}
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">人気記事を準備中です🌿 もうしばらくお待ちください。</p>
				)}
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
