---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE } from '../consts';

const works = [
	{ icon: '🌱', name: 'となりのトトロ',       desc: 'ほのぼのトトログッズ' },
	{ icon: '🛁', name: '千と千尋の神隠し',     desc: '湯屋の世界に浸る' },
	{ icon: '🐺', name: 'もののけ姫',            desc: '森と神々のグッズ' },
	{ icon: '🧹', name: '魔女の宅急便',          desc: 'キキと一緒に飛ぼう' },
	{ icon: '🏰', name: '天空の城ラピュタ',      desc: 'バルスの世界' },
	{ icon: '🌾', name: '風の谷のナウシカ',      desc: '風の谷の記憶' },
	{ icon: '🐟', name: '崖の上のポニョ',        desc: '海の女の子' },
	{ icon: '🔥', name: 'ハウルの動く城',        desc: '動く城の住人たち' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`作品別 | ${SITE_TITLE}`} description="ジブリグッズブログの作品別一覧です。お好みの作品からお探しください。" />
		<style>
			.page-outer {
				max-width: 1120px;
				margin: 0 auto;
				padding: 0 1.5em;
				display: flex;
				gap: 2.5em;
				align-items: flex-start;
			}
			.page-main {
				flex: 1;
				min-width: 0;
			}
			.page-heading {
				padding: 2.2em 0 1.8em;
			}
			.page-heading__label {
				font-size: 0.68em;
				font-weight: 700;
				color: var(--orange);
				letter-spacing: 0.22em;
				display: block;
				margin-bottom: 0.4em;
			}
			.page-heading__title {
				font-family: var(--font-hand);
				font-size: 1.6em;
				font-weight: 700;
				color: var(--text);
				margin: 0;
				line-height: 1.3;
			}

			.work-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.85rem;
				list-style: none;
				margin: 0;
				padding: 0 0 4em;
			}
			.work-card {
				background: var(--milk);
				border: 2px solid var(--beige-light);
				border-radius: 18px 14px 20px 12px / 14px 20px 12px 18px;
				overflow: hidden;
				transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
			}
			.work-card:hover {
				transform: translateY(-3px);
				box-shadow: var(--shadow-md);
				border-color: var(--orange-light);
				background: #fff;
			}
			.work-card a {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1.6em 0.8em 1.5em;
				gap: 0.35em;
				text-decoration: none;
				color: inherit;
			}
			.work-card__icon {
				font-size: 2em;
				line-height: 1;
				margin-bottom: 0.2em;
			}
			.work-card__name {
				font-size: 0.82em;
				font-weight: 700;
				color: var(--text);
				line-height: 1.4;
			}
			.work-card__desc {
				font-size: 0.68em;
				color: var(--text-muted);
				line-height: 1.35;
			}
			.work-card__bar {
				height: 3px;
				background: linear-gradient(90deg, var(--orange) 0%, var(--orange-light) 50%, var(--green-light) 100%);
			}

			@media (max-width: 860px) {
				.page-outer { padding: 0 1em; }
			}
			@media (max-width: 600px) {
				.work-grid { grid-template-columns: repeat(2, 1fr); }
				.page-heading { padding: 1.5em 0 1.2em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-outer">
			<main class="page-main">
				<div class="page-heading">
					<span class="page-heading__label">BY WORKS</span>
					<h1 class="page-heading__title">作品から探す</h1>
				</div>
				<ul class="work-grid">
					{works.map((w) => (
						<li class="work-card">
							<div class="work-card__bar" />
							<a href={`/works/${encodeURIComponent(w.name)}`}>
								<span class="work-card__icon">{w.icon}</span>
								<span class="work-card__name">{w.name}</span>
								<span class="work-card__desc">{w.desc}</span>
							</a>
						</li>
					))}
				</ul>
			</main>
			<Sidebar />
		</div>
		<Footer />
	</body>
</html>
