									<span class="category-card__icon">{cat.icon}</span>
									<span class="category-card__name">{cat.name}</span>
									<span class="category-card__desc">{cat.desc}</span>
								</a>
							</li>
						))}
					</ul>
					<div class="home-section__more">
						<a href="/categories">カテゴリをすべて見る →</a>
					</div>
				</div>
			</section>

			<div class="home-section__inner"><Divider variant="curl" /></div>

			<!-- このブログについて -->
			<section class="home-section home-section--alt" id="about">
				<div class="home-section__inner">
					<div class="home-section__heading">
						<span class="home-section__heading-label">ABOUT THIS BLOG</span>
						<span class="home-section__heading-text">このブログについて</span>
					</div>
					<div class="about-teaser">
						<div class="about-teaser__icon">{homeAbout.icon}</div>
						<div class="about-teaser__text">
							<h3>{homeAbout.name}</h3>
							{homeAbout.text.split('\n').filter((l: string) => l.trim()).map((line: string) => (
								<p>{line}</p>
							))}
							<a href="/about" class="about-teaser__link">プロフィールを読む →</a>
						</div>
					</div>
				</div>
			</section>

		</main>

		<!-- 整理棚（右サイドバー） -->
		<Sidebar />

	</div><!-- /.page-outer -->

	<Footer />

	<!-- 季節にあわせてヒーローの木を切り替える（春:桜/夏:ひまわり/秋:紅葉/冬:雪だるま） -->
	<script is:inline>
		(function () {
			var m = new Date().getMonth() + 1;
			var s = m >= 3 && m <= 5 ? 'spring' : m >= 6 && m <= 8 ? 'summer' : m >= 9 && m <= 11 ? 'autumn' : 'winter';
			document.querySelectorAll('[data-season]').forEach(function (g) {
				g.style.display = g.getAttribute('data-season') === s ? '' : 'none';
			});
		})();
	</script>
</body>
</html>
