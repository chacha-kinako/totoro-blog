---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Divider from '../components/Divider.astro';
import HandIcon from '../components/HandIcon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import siteConfig from '../data/site-config.json';

const homeAbout = siteConfig.homeAbout;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = allPosts.slice(0, 3);
const featuredPosts = allPosts.filter(p => p.data.featured || p.data.showInPopular).slice(0, 3);

const homeCategories = [
	{ icon: '💎', name: 'コレクション',    desc: 'お気に入りを集めて',   href: '/categories/コレクション' },
	{ icon: '✨', name: 'おすすめ・まとめ', desc: '迷ったらここから',     href: '/categories/おすすめ・まとめ' },
	{ icon: '🎁', name: '今月の仲間入り',  desc: '新しく迎えたグッズ',   href: '/categories/今月の仲間入り' },
	{ icon: '📖', name: 'お小遣い帳',      desc: 'リアルな収支公開',     href: '/categories/お小遣い帳' },
];

// ビルド時点の季節（表示後にJSで現在の月に合わせて切り替える）
const month = new Date().getMonth() + 1;
const defaultSeason =
	month >= 3 && month <= 5 ? 'spring'
	: month >= 6 && month <= 8 ? 'summer'
	: month >= 9 && month <= 11 ? 'autumn'
	: 'winter';
const seasonDisplay = (s: string) => (s === defaultSeason ? '' : 'display:none');
---

<!doctype html>
<html lang="ja">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	<style>
		/* ── クレヨンヒーロー（外の景色のイラスト・季節で変化） ── */
		.crayon-hero {
			padding: 2.8em 1.5em 1.2em;
		}
		.crayon-hero__inner {
			max-width: 1020px;
			margin: 0 auto;
			display: flex;
			align-items: center;
			gap: 2.4em;
		}
		.crayon-hero__text {
			flex: 1;
			min-width: 0;
		}
		.crayon-hero__label {
			display: inline-block;
			font-size: 0.7em;
			font-weight: 700;
			font-family: var(--font-hand);
			color: var(--blue-ink);
			letter-spacing: 0.2em;
			text-transform: uppercase;
			margin: 0 0 1em;
			padding: 0.35em 1.2em;
			border: 2px solid var(--blue-light);
			border-radius: 24px 28px 20px 30px / 28px 20px 30px 24px;
			background: #fff;
		}
		.crayon-hero__title {
			font-family: var(--font-hand);
			font-size: 2.5em;
			font-weight: 700;
			color: var(--blue-ink);
			margin: 0 0 0.5em;
			letter-spacing: 0.04em;
			line-height: 1.45;
		}
		.crayon-hero__title em {
			font-style: normal;
			color: var(--orange);
		}
		.crayon-hero__tagline {
			font-size: 0.92em;
			color: var(--text-muted);
			margin: 0;
			letter-spacing: 0.04em;
			line-height: 2.1;
		}
		.crayon-hero__art {
			width: min(46%, 470px);
			flex-shrink: 0;
		}
		.crayon-hero__art svg {
			width: 100%;
			height: auto;
			display: block;
		}
		@media (max-width: 720px) {
			.crayon-hero { padding: 1.6em 1em 0.6em; }
			.crayon-hero__inner {
				flex-direction: column;
				gap: 0.8em;
				text-align: center;
			}
			.crayon-hero__title { font-size: 1.75em; }
			.crayon-hero__art { width: min(90%, 400px); }
		}

		/* ── クイックナビ ── */
		.quick-nav {
			display: flex;
			justify-content: center;
			flex-wrap: wrap;
			gap: 0.7em;
			padding: 1.6em 1em 2em;
			border-bottom: 2px dashed var(--beige);
		}
		.quick-nav__btn {
			display: inline-flex;
			align-items: center;
			padding: 0.5em 1.2em;
			border-radius: 26px 30px 22px 32px / 30px 22px 32px 26px;
			font-size: 0.81em;
			font-weight: 700;
			font-family: var(--font-hand);
			text-decoration: none;
			transition: transform 0.18s, box-shadow 0.18s, background 0.18s, color 0.18s;
			border: 2px solid var(--blue-light);
			color: var(--blue-ink);
			background: #fff;
			letter-spacing: 0.02em;
			box-shadow: var(--shadow-sm);
		}
		.quick-nav__btn:hover {
			background: var(--blue-pale);
			color: var(--blue-ink-dark);
			border-color: var(--blue-ink);
			text-decoration: none;
			transform: translateY(-2px) scale(1.03);
			box-shadow: var(--shadow-hover);
		}
		.quick-nav__btn--fill {
			background: var(--mustard-pale);
			color: var(--mustard-dark);
			border-color: var(--mustard-light);
		}
		.quick-nav__btn--fill:hover {
			background: var(--mustard-light);
			border-color: var(--mustard);
			color: #fff;
		}

		/* ── 2カラムレイアウト（メイン + 整理棚） ── */
		.page-outer {
			max-width: 1320px;
			margin: 0 auto;
			padding: 0 0.5em 0 1.5em;
			display: flex;
			gap: 4em;
			align-items: flex-start;
		}
		.page-main {
			flex: 1;
			min-width: 0;
			/* global.css の "main { width: 880px; margin: auto; padding: ... }" を上書き */
			width: auto;
			max-width: none;
			margin: 0;
			padding: 0;
		}

		/* ── セクション共通 ── */
		.home-section {
			padding: 3.5em 0;
		}
		.home-section--alt {
			background: transparent;
		}
		.home-section--white {
			background: transparent;
		}
		.home-section__inner {
			/* 左右に約2cmの余白 */
			padding: 0 2em;
		}
		.home-section__heading {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.3em;
			margin: 0 0 2em;
		}
		.home-section__heading-label {
			font-size: 0.66em;
			font-weight: 700;
			color: var(--gray-light);
			letter-spacing: 0.22em;
		}
		.home-section__heading-text {
			font-family: var(--font-hand);
			font-size: 1.35em;
			font-weight: 700;
			color: var(--blue-ink);
			line-height: 1.3;
			padding-bottom: 0.35em;
			text-decoration: underline wavy var(--blue-light) 2.5px;
			text-underline-offset: 10px;
		}
		.home-section__heading-text::before {
			content: '★ ';
			color: var(--mustard);
		}
		.home-section__more {
			text-align: center;
			margin-top: 2.2em;
		}
		.home-section__more a {
			display: inline-block;
			padding: 0.6em 2em;
			border: 2px solid var(--blue-light);
			color: var(--blue-ink);
			background: #fff;
			border-radius: 26px 30px 22px 32px / 30px 22px 32px 26px;
			font-size: 0.82em;
			font-weight: 700;
			font-family: var(--font-hand);
			text-decoration: none;
			transition: transform 0.18s, box-shadow 0.18s, background 0.18s, color 0.18s;
			letter-spacing: 0.02em;
		}
		.home-section__more a:hover {
			background: var(--blue-pale);
			color: var(--blue-ink-dark);
			border-color: var(--blue-ink);
			text-decoration: none;
			transform: translateY(-2px);
			box-shadow: var(--shadow-hover);
		}

		/* ── 記事カードグリッド ── */
		.post-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 1.8rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.post-card {
			background: #fff;
			border-radius: 20px 16px 22px 14px / 16px 22px 14px 20px;
			border: 2px solid var(--beige-light);
			box-shadow: var(--shadow-sm);
			overflow: hidden;
			transition: transform 0.2s, box-shadow 0.2s;
		}
		.post-card:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-hover);
		}
		.post-card a {
			display: block;
			text-decoration: none;
			color: inherit;
			height: 100%;
		}
		.post-card__thumb {
			position: relative;
			width: 100%;
			aspect-ratio: 3 / 2;
			overflow: hidden;
		}
		.post-card__thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.3s;
			filter: url(#crayon-photo);
		}
		.post-card:hover .post-card__thumb img { transform: scale(1.04); }
		.post-card__thumb-label {
			position: absolute;
			bottom: 0.7em;
			left: 0.8em;
			background: rgba(255,255,255,0.93);
			color: var(--orange-dark);
			font-family: var(--font-hand);
			font-size: 0.79em;
			font-weight: 700;
			padding: 0.25em 0.8em;
			border-radius: 50px;
			letter-spacing: 0.04em;
		}
		.post-card__bar {
			height: 4px;
			background: var(--mustard-light);
		}
		.post-card__body {
			padding: 1.2em 1.3em 1.5em;
		}
		.post-card__date {
			font-size: 0.71em;
			color: var(--text-muted);
			font-weight: 600;
			margin-bottom: 0.4em;
		}
		.post-card__title {
			font-size: 0.92em;
			font-weight: 700;
			font-family: var(--font-hand);
			color: var(--blue-ink);
			line-height: 1.6;
			margin: 0 0 0.4em;
			display: -webkit-box;
			-webkit-line-clamp: 3;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.post-card__desc {
			font-size: 0.76em;
			color: var(--text-muted);
			line-height: 1.6;
			margin: 0;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.post-card--coming {
			opacity: 0.55;
			pointer-events: none;
		}
		.post-card--coming .post-card__title {
			color: var(--text-muted);
			font-style: italic;
		}

		/* ── 図鑑・レビュー入口 ── */
		.entrance-grid {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 2.4rem;
		}
		.entrance-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			background: #fff;
			border-radius: 26px 20px 28px 18px / 20px 28px 18px 26px;
			border: 2px solid var(--beige);
			box-shadow: var(--shadow-sm);
			padding: 3em 2em 2.6em;
			text-decoration: none;
			color: inherit;
			transition: transform 0.22s, box-shadow 0.22s, border-color 0.22s;
			overflow: hidden;
			position: relative;
		}
		.entrance-card::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 4px;
			background: var(--mustard-light);
		}
		.entrance-card:hover {
			transform: translateY(-6px);
			box-shadow: var(--shadow-hover);
			border-color: var(--orange-light);
			text-decoration: none;
		}
		.entrance-card__icon {
			line-height: 1;
			margin-bottom: 0.5em;
			color: var(--orange);
			display: flex;
		}
		.entrance-card__title {
			font-family: var(--font-hand);
			font-size: 1.25em;
			font-weight: 700;
			color: var(--text);
			margin: 0 0 0.45em;
		}
		.entrance-card__desc {
			font-size: 0.82em;
			color: var(--text-muted);
			line-height: 1.65;
			margin: 0 0 1.4em;
		}
		.entrance-card__btn {
			display: inline-block;
			padding: 0.55em 1.8em;
			border-radius: 26px 30px 22px 32px / 30px 22px 32px 26px;
			border: 2px solid var(--orange-light);
			color: var(--orange-dark);
			font-family: var(--font-hand);
			font-size: 0.82em;
			font-weight: 700;
			transition: background 0.18s, color 0.18s;
		}
		.entrance-card:hover .entrance-card__btn {
			background: var(--orange);
			color: #fff;
			border-color: var(--orange);
		}

		/* ── カテゴリグリッド ── */
		.category-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.3rem;
			list-style: none;
			margin: 0;
			padding: 0;
		}
		/* 4カテゴリ固定なのでPC4列のまま */
		.category-card {
			background: var(--milk);
			border: 2px solid var(--beige-light);
			border-radius: 18px 14px 20px 12px / 14px 20px 12px 18px;
			overflow: hidden;
			transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
		}
		.category-card:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-md);
			border-color: var(--orange-light);
			background: #fff;
		}
		.category-card a {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1.4em 0.7em 1.3em;
			gap: 0.3em;
			text-decoration: none;
			color: inherit;
		}
		.category-card__icon {
			font-size: 1.8em;
			line-height: 1;
			margin-bottom: 0.15em;
		}
		.category-card__name {
			font-size: 0.77em;
			font-weight: 700;
			font-family: var(--font-hand);
			color: var(--text);
			line-height: 1.4;
		}
		.category-card__desc {
			font-size: 0.65em;
			color: var(--text-muted);
			line-height: 1.35;
		}
		.category-card__bar {
			height: 3px;
			background: var(--mustard-light);
		}

		/* ── このブログについて ── */
		.about-teaser {
			display: flex;
			align-items: center;
			gap: 2.2em;
			background: #fff;
			border-radius: 24px 18px 26px 16px / 18px 26px 16px 24px;
			border: 2px solid var(--beige-light);
			padding: 2.2em 2.4em;
			box-shadow: var(--shadow-sm);
		}
		.about-teaser__icon {
			font-size: 3em;
			flex-shrink: 0;
			line-height: 1;
		}
		.about-teaser__text h3 {
			font-family: var(--font-hand);
			font-size: 1.1em;
			color: var(--orange-dark);
			margin: 0 0 0.5em;
		}
		.about-teaser__text p {
			font-size: 0.86em;
			color: var(--text-muted);
			margin: 0 0 0.9em;
			line-height: 1.75;
		}
		.about-teaser__link {
			font-size: 0.82em;
			font-weight: 700;
			color: var(--orange);
			text-decoration: none;
			border-bottom: 1.5px solid var(--orange-light);
			padding-bottom: 1px;
			transition: color 0.15s;
		}
		.about-teaser__link:hover { color: var(--orange-dark); }

		/* ── レスポンシブ ── */
		@media (max-width: 860px) {
			/* サイドバーが非表示になるので余白を戻す */
			.page-outer { padding: 0 1.5em; gap: 0; }
		}
		@media (max-width: 720px) {
			.home-title-area__blog { font-size: 1.65em; }
			.home-section__inner { padding: 0 1em; }
			.post-grid { grid-template-columns: 1fr; gap: 1.2rem; }
			.category-grid { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
			.entrance-grid { grid-template-columns: 1fr; gap: 1.4rem; }
			.about-teaser { flex-direction: column; gap: 1em; padding: 1.5em; }
			.home-section { padding: 2.8em 0; }
		}
		@media (min-width: 721px) and (max-width: 860px) {
			.post-grid { grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
			.category-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
		}
	</style>
</head>
<body>
	<Header />

	<!-- クレヨンヒーロー：外の景色（丸窓の家）・季節で変化 -->
	<section class="crayon-hero">
		<div class="crayon-hero__inner">
			<div class="crayon-hero__text">
				<p class="crayon-hero__label">ghibli life blog</p>
				<h1 class="crayon-hero__title">
					トトロと<em>暮らす</em><br />丸窓の家
				</h1>
				<p class="crayon-hero__tagline">
					グッズ・暮らし・お気に入りをのんびり発信中。<br />
					絵本の中のおうちへ、あそびにきてください🌿
				</p>
			</div>
			<div class="crayon-hero__art">
				<svg viewBox="0 0 480 350" role="img" aria-label="丸窓の家と季節の木のクレヨンイラスト" xmlns="http://www.w3.org/2000/svg">
					<!-- 太陽 -->
					<g filter="url(#hand-wobble)">
						<circle cx="62" cy="56" r="19" fill="var(--mustard-light)" stroke="var(--mustard)" stroke-width="2.5" />
						<g stroke="var(--mustard)" stroke-width="2.2" stroke-linecap="round">
							<line x1="62" y1="24" x2="62" y2="14" />
							<line x1="62" y1="88" x2="62" y2="98" />
							<line x1="30" y1="56" x2="20" y2="56" />
							<line x1="94" y1="56" x2="104" y2="56" />
							<line x1="39" y1="33" x2="32" y2="26" />
							<line x1="85" y1="79" x2="92" y2="86" />
							<line x1="39" y1="79" x2="32" y2="86" />
							<line x1="85" y1="33" x2="92" y2="26" />
						</g>
					</g>

					<!-- 雲 -->
					<g filter="url(#hand-wobble)" fill="var(--blue-pale)" stroke="var(--blue-light)" stroke-width="2">
						<g>
							<circle cx="165" cy="48" r="13" />
							<circle cx="182" cy="42" r="10" />
							<circle cx="148" cy="44" r="9" />
						</g>
						<g>
							<circle cx="435" cy="68" r="11" />
							<circle cx="450" cy="63" r="8" />
						</g>
					</g>

					<!-- 地面（草原） -->
					<g filter="url(#hand-wobble)">
						<path d="M0 297 Q120 287 240 294 T480 292 L480 350 L0 350 Z" fill="var(--green-pale)" />
						<path d="M0 297 Q120 287 240 294 T480 292" fill="none" stroke="var(--green-light)" stroke-width="2.4" />
					</g>

					<!-- おうち（丸窓の家） -->
					<g filter="url(#hand-wobble)">
						<rect x="258" y="150" width="178" height="147" rx="4" fill="#FBF3DF" stroke="#8A5F3E" stroke-width="2.6" />
						<path d="M243 155 L347 92 L451 155 Z" fill="#DE9573" stroke="#94523A" stroke-width="2.6" stroke-linejoin="round" />
						<path d="M280 143 L347 103 M414 143 L347 103" stroke="#C97B56" stroke-width="1.6" fill="none" opacity="0.6" />
						<rect x="398" y="104" width="18" height="36" fill="#C9A98C" stroke="#8A5F3E" stroke-width="2" />
						<path d="M407 96 Q413 88 407 80 Q401 72 408 64" fill="none" stroke="var(--gray-light)" stroke-width="2.4" stroke-linecap="round" />
						<!-- 丸窓 -->
						<circle cx="398" cy="190" r="22" fill="#EBF1F3" stroke="#8A5F3E" stroke-width="2.6" />
						<line x1="376" y1="190" x2="420" y2="190" stroke="#8A5F3E" stroke-width="1.8" />
						<line x1="398" y1="168" x2="398" y2="212" stroke="#8A5F3E" stroke-width="1.8" />
						<!-- 青い扉 -->
						<path d="M284 297 L284 218 Q284 191 312 191 Q340 191 340 218 L340 297 Z" fill="#6FA0D8" stroke="#3A6293" stroke-width="2.6" />
						<rect x="303" y="206" width="19" height="15" rx="6" fill="#EBF1F3" stroke="#3A6293" stroke-width="1.8" />
						<circle cx="331" cy="255" r="3.2" fill="var(--mustard)" />
						<rect x="276" y="296" width="72" height="8" rx="3" fill="#C9A98C" stroke="#8A5F3E" stroke-width="1.6" />
						<!-- 扉のよこの鉢植え -->
						<path d="M358 278 L376 278 L372 298 L362 298 Z" fill="#C97B56" stroke="#94523A" stroke-width="1.8" />
						<g fill="#A8CB8E" stroke="#6B9552" stroke-width="1.4">
							<ellipse cx="360" cy="268" rx="6" ry="10" transform="rotate(-25 360 268)" />
							<ellipse cx="367" cy="263" rx="6" ry="11" />
							<ellipse cx="374" cy="268" rx="6" ry="10" transform="rotate(25 374 268)" />
						</g>
